<odoo>
<record id="form_view" model="ir.ui.view"><field name="name">lab.workflow.form</field><field name="model">lab.workflow.form</field><field name="arch" type="xml"><form><header><button name="action_confirm" string="Confirm" type="object"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="suggestion"/><field name="quantity"/></group></sheet></form></field></record>
<record id="form_action" model="ir.actions.act_window"><field name="name">Workflow form</field><field name="res_model">lab.workflow.form</field><field name="view_mode">list,form</field></record>
<template id="invoice_technical_zero" inherit_id="account.report_invoice_document"><xpath expr="//t[@name='account_invoice_line_accountable']" position="attributes"><attribute name="t-if" add="not (line.lab_technical_zero and line.price_subtotal == 0)" separator=" and "/></xpath></template>
</odoo>
