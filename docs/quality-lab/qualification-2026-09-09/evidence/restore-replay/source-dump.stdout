stom_colors\\">\\n                                    <i class=\\"fa fa-repeat\\"/> Reset\\n                                    <field name=\\"custom_colors\\" class=\\"position-absolute top-0 start-0 w-100 h-100 opacity-0\\" nolabel=\\"1\\"/>\\n                                </a>\\n                            </div>\\n\\n                            <field name=\\"company_details\\" string=\\"Address\\" options=\\"{'resizable': false}\\"/>\\n                            <field name=\\"report_header\\" string=\\"Tagline\\" placeholder=\\"e.g. Global Business Solutions\\" options=\\"{'resizable': false}\\"/>\\n                            <field name=\\"report_footer\\" placeholder=\\"Write your phone, email, bank account, tax ID, ...\\" string=\\"Footer\\" options=\\"{'resizable': false}\\"/>\\n                            <field name=\\"paperformat_id\\" widget=\\"selection\\" required=\\"1\\"/>\\n                        </group>\\n                        <div class=\\"o_preview\\">\\n                            <field name=\\"preview\\" widget=\\"iframe_wrapper\\" class=\\"preview_document_layout d-flex justify-content-center mb-0\\"/>\\n                        </div>\\n                    </group>\\n                    <footer>\\n                        <button string=\\"Continue\\" class=\\"btn-primary\\" type=\\"object\\" name=\\"document_layout_save\\" data-hotkey=\\"q\\"/>\\n                        <button special=\\"cancel\\" data-hotkey=\\"x\\" string=\\"Discard\\"/>\\n                    </footer>\\n                </form>"}	<?xml version="1.0"?>\n<form class="o_document_layout">\n                    <group>\n                        <group class="o_document_layout_company">\n                            <field name="company_id" invisible="1"/>\n                            <field name="external_report_layout_id" invisible="1"/>\n                            <field name="logo_primary_color" invisible="1"/>\n                            <field name="logo_secondary_color" invisible="1"/>\n\n                            <field name="report_layout_id" string="Layout" widget="selection_badge" required="1" options="{'horizontal': true, 'size': 'sm'}"/>\n                            <field name="layout_background" string="Background" widget="selection" required="1"/>\n                            <field name="layout_background_image" options="{'accepted_file_extensions': 'image/*'}" invisible="layout_background != 'Custom'" required="layout_background == 'Custom'">Upload your file</field>\n                            <field name="font" string="Text" widget="selection" required="1"/>\n                            <field name="logo" string="Logo" widget="image" options="{'size': [0, 50]}"/>\n\n                            <label for="primary_color" string="Colors"/>\n                            <div class="o_document_layout_colors d-flex align-items-end mb-4">\n                                <field name="primary_color" widget="color" class="w-auto m-0 me-1"/>\n                                <field name="secondary_color" widget="color" class="w-auto m-0"/>\n                                <a class="o_custom_colors btn btn-secondary btn-sm position-relative ms-2" role="button" title="Reset to logo colors" invisible="not custom_colors">\n                                    <i class="fa fa-repeat"/> Reset\n                                    <field name="custom_colors" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" nolabel="1"/>\n                                </a>\n                            </div>\n\n                            <field name="company_details" string="Address" options="{'resizable': false}"/>\n                            <field name="report_header" string="Tagline" placeholder="e.g. Global Business Solutions" options="{'resizable': false}"/>\n                            <field name="report_footer" placeholder="Write your phone, email, bank account, tax ID, ..." string="Footer" options="{'resizable': false}"/>\n                            <field name="paperformat_id" widget="selection" required="1"/>\n                        </group>\n                        <div class="o_preview">\n                            <field name="preview" widget="iframe_wrapper" class="preview_document_layout d-flex justify-content-center mb-0"/>\n                        </div>\n                    </group>\n                    <footer>\n                        <button string="Continue" class="btn-primary" type="object" name="document_layout_save" data-hotkey="q"/>\n                        <button special="cancel" data-hotkey="x" string="Discard"/>\n                    </footer>\n                </form>\n            	f	t	2026-09-09 14:26:22.945456	2026-09-09 14:26:22.945456
220	16	\N	1	1	view_speedscope_index	\N	web.view_speedscope_index	qweb	web/views/speedscope_template.xml	primary	{"en_US": "<t t-name=\\"web.view_speedscope_index\\">\\n        &lt;!DOCTYPE html&gt;\\n        <html lang=\\"en\\">\\n            <head>\\n                <meta charset=\\"UTF-8\\"/>\\n                <title>Speedscope for odoo</title>\\n                <script>window.location.hash=\\"#localProfilePath=1\\"</script>\\n                <link href=\\"https://fonts.googleapis.com/css?family=Source+Code+Pro\\" rel=\\"stylesheet\\"/>\\n                <link rel=\\"stylesheet\\" t-attf-href=\\"{{cdn}}reset.8c46b7a1.css\\" crossorigin=\\"anonymous\\" integrity=\\"sha256-mrA/937EwtEDE+8XZ/62tNz2T/BnCLth8QmWsWKpvD8=\\"/>\\n            </head>\\n            <body>\\n                <script t-attf-src=\\"{{cdn}}speedscope.026f36b0.js\\" crossorigin=\\"anonymous\\" integrity=\\"sha256-CvDqAOMjq0Sv/D59O5JSbzzXoClZ3rptt6ts8D/6CWw=\\"/>\\n                <script>\\n                const b64 = '<t t-esc=\\"speedscope_base64\\"/>';\\n                document.addEventListener(\\"DOMContentLoaded\\", () =&gt; {\\n                    speedscope.loadFileFromBase64('Profile', b64);\\n                });\\n                </script>\\n            </body>\\n        </html>\\n    </t>"}	<?xml version="1.0"?>\n<t t-name="web.view_speedscope_index">\n        &lt;!DOCTYPE html&gt;\n        <html lang="en">\n            <head>\n                <meta charset="UTF-8"/>\n                <title>Speedscope for odoo</title>\n                <script>window.location.hash="#localProfilePath=1"</script>\n                <link href="https://fonts.googleapis.com/css?family=Source+Code+Pro" rel="stylesheet"/>\n                <link rel="stylesheet" t-attf-href="{{cdn}}reset.8c46b7a1.css" crossorigin="anonymous" integrity="sha256-mrA/937EwtEDE+8XZ/62tNz2T/BnCLth8QmWsWKpvD8="/>\n            </head>\n            <body>\n                <script t-attf-src="{{cdn}}speedscope.026f36b0.js" crossorigin="anonymous" integrity="sha256-CvDqAOMjq0Sv/D59O5JSbzzXoClZ3rptt6ts8D/6CWw="/>\n                <script>\n                const b64 = '<t t-esc="speedscope_base64"/>';\n                document.addEventListener("DOMContentLoaded", () =&gt; {\n                    speedscope.loadFileFromBase64('Profile', b64);\n                });\n                </script>\n            </body>\n        </html>\n    </t>\n	f	t	2026-09-09 14:26:22.945456	2026-09-09 14:26:22.945456
221	16	\N	1	1	view_memory	\N	web.view_memory	qweb	web/views/memory_template.xml	primary	{"en_US": "<t t-name=\\"web.view_memory\\">\\n        &lt;!DOCTYPE html&gt;\\n        <html lang=\\"en\\">\\n        <head>\\n            <meta charset=\\"UTF-8\\"/>\\n            <meta name=\\"viewport\\" content=\\"width=device-width, initial-scale=1.0\\"/>\\n            <title>Memory Usage Visualization</title>\\n            <script src=\\"https://cdn.jsdelivr.net/npm/chart.js\\"/>\\n            <style>\\n                * { box-sizing: border-box; margin: 0; padding: 0; }\\n                body {\\n                    font-family: Arial, sans-serif;\\n                    background-color: #f9f9f9;\\n                    height: 100vh;\\n                    display: flex;\\n                    flex-direction: column;\\n                }\\n                .chart-row {\\n                    height: 30vh;\\n                    min-height: 200px;\\n                    padding: 10px;\\n                    flex-shrink: 0;\\n                }\\n                .chart-container {\\n                    position: relative;\\n                    background: #fff;\\n                    border: 1px solid #ddd;\\n                    border-radius: 5px;\\n                    padding: 10px;\\n                    height: 100%;\\n                    width: 100%;\\n                }\\n                .speedscope-row {\\n                    flex: 1;\\n                    min-height: 0;\\n                    padding: 0 10px 10px;\\n                }\\n                .speedscope-row iframe {\\n                    width: 100%;\\n                    height: 100%;\\n                    border: 1px solid #ddd;\\n                    border-radius: 5px;\\n                }\\n            </style>\\n        </head>\\n        <body>\\n            <div class=\\"chart-row\\">\\n                <div class=\\"chart-container\\">\\n                    <canvas id=\\"memoryChart\\"/>\\n                </div>\\n            </div>\\n            <div class=\\"speedscope-row\\">\\n                <iframe id=\\"speedscopeFrame\\" sandbox=\\"allow-scripts allow-same-origin\\"/>\\n            </div>\\n\\n            <script>\\n                // --- DATA FROM SERVER ---\\n                const memoryData = JSON.parse(atob('<t t-esc=\\"memory_data\\"/>'));\\n                const fullSpeedscopeBase64 = '<t t-esc=\\"speedscope_base64\\"/>';\\n                const cdn = '<t t-esc=\\"cdn\\"/>';\\n                const points = memoryData.points;\\n\\n                // --- UTILITY ---\\n                function formatBytes(bytes) {\\n                    if (bytes === 0) return '0 B';\\n                    const k = 1024;\\n                    const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];\\n                    const i = Math.floor(Math.log(Math.abs(bytes)) / Math.log(k));\\n                    const sign = bytes &lt; 0 ? '-' : '';\\n                    return sign + (Math.abs(bytes) / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i];\\n                }\\n\\n                function formatTimestamp(ts) {\\n                    return new Date(ts * 1000).toLocaleTimeString();\\n                }\\n\\n                // --- SPEEDSCOPE IFRAME ---\\n                let currentBlobUrl = null;\\n\\n                function loadSpeedscopeInIframe(base64Data) {\\n                    if (currentBlobUrl) URL.revokeObjectURL(currentBlobUrl);\\n\\n                    const html = '\\\\x3c!DOCTYPE html\\\\x3e' +\\n                        '\\\\x3chtml\\\\x3e\\\\x3chead\\\\x3e' +\\n                        '\\\\x3cscript\\\\x3ewindow.location.hash=\\"#localProfilePath=1\\";\\\\x3c/script\\\\x3e' +\\n                        '\\\\x3clink href=\\"https://fonts.googleapis.com/css?family=Source+Code+Pro\\" rel=\\"stylesheet\\"/\\\\x3e' +\\n                        '\\\\x3clink rel=\\"stylesheet\\" href=\\"' + cdn + 'reset.8c46b7a1.css\\"/\\\\x3e' +\\n                        '\\\\x3c/head\\\\x3e\\\\x3cbody\\\\x3e' +\\n                        '\\\\x3cscript src=\\"' + cdn + 'speedscope.026f36b0.js\\"\\\\x3e\\\\x3c/script\\\\x3e' +\\n                        '\\\\x3cscript\\\\x3e' +\\n                        'document.addEventListener(\\"DOMContentLoaded\\", function() {' +\\n                        '  speedscope.loadFileFromBase64(\\"Profile\\", \\"' + base64Data + '\\");' +\\n                        '});' +\\n                        '\\\\x3c/script\\\\x3e' +\\n                        '\\\\x3c/body\\\\x3e\\\\x3c/html\\\\x3e';\\n\\n                    const blob = new Blob([html], {type: 'text/html'});\\n                    currentBlobUrl = URL.createObjectURL(blob);\\n                    document.getElementById('speedscopeFrame').src = currentBlobUrl;\\n                }\\n\\n                // --- CHART (hover-only, no click interaction) ---\\n                const labels = points.map(p =&gt; formatTimestamp(p.timestamp));\\n                const memValues = points.map(p =&gt; p.memory);\\n\\n                new Chart(document.getElementById('memoryChart'), {\\n                    type: 'line',\\n                    data: {\\n                        labels: labels,\\n                        datasets: [{\\n                            label: 'RSS Memory (baselined)',\\n                            data: memValues,\\n                            fill: true,\\n                            backgroundColor: 'rgba(75, 192, 192, 0.1)',\\n                            borderColor: 'rgba(75, 192, 192, 1)',\\n                            tension: 0.1,\\n                            pointRadius: 2,\\n                            pointBackgroundColor: 'rgba(75, 192, 192, 1)',\\n                        }]\\n                    },\\n                    options: {\\n                        responsive: true,\\n                        maintainAspectRatio: false,\\n                        plugins: {\\n                            title: { display: true, text: 'RSS Memory Over Time' },\\n                            tooltip: {\\n                                callbacks: {\\n                                    label: ctx =&gt; 'Δ ' + formatBytes(ctx.raw),\\n                                    afterLabel: ctx =&gt; 'Absolute: ' + formatBytes(points[ctx.dataIndex].abs_memory),\\n                                }\\n                            },\\n                            legend: { display: false },\\n                        },\\n                        scales: {\\n                            y: {\\n                                title: { display: true, text: 'Memory (Δ from baseline)' },\\n                                ticks: { callback: v =&gt; formatBytes(v) },\\n                            },\\n                            x: {\\n                                title: { display: true, text: 'Time' },\\n                                ticks: { maxTicksLimit: 20 },\\n                            }\\n                        }\\n                    }\\n                });\\n\\n                // Load full memory speedscope\\n                loadSpeedscopeInIframe(fullSpeedscopeBase64);\\n            </script>\\n        </body>\\n        </html>\\n    </t>"}	<?xml version="1.0"?>\n<t t-name="web.view_memory">\n        &lt;!DOCTYPE html&gt;\n        <html lang="en">\n        <head>\n            <meta charset="UTF-8"/>\n            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>\n            <title>Memory Usage Visualization</title>\n            <script src="https://cdn.jsdelivr.net/npm/chart.js"/>\n            <style>\n                * { box-sizing: border-box; margin: 0; padding: 0; }\n                body {\n                    font-family: Arial, sans-serif;\n                    background-color: #f9f9f9;\n                    height: 100vh;\n                    display: flex;\n                    flex-direction: column;\n                }\n                .chart-row {\n                    height: 30vh;\n                    min-height: 200px;\n                    padding: 10px;\n                    flex-shrink: 0;\n                }\n                .chart-container {\n                    position: relative;\n                    background: #fff;\n                    border: 1px solid #ddd;\n                    border-radius: 5px;\n                    padding: 10px;\n                    height: 100%;\n                    width: 100%;\n                }\n                .speedscope-row {\n                    flex: 1;\n                    min-height: 0;\n                    padding: 0 10px 10px;\n                }\n                .speedscope-row iframe {\n                    width: 100%;\n                    height: 100%;\n                    border: 1px solid #ddd;\n                    border-radius: 5px;\n                }\n            </style>\n        </head>\n        <body>\n            <div class="chart-row">\n                <div class="chart-container">\n                    <canvas id="memoryChart"/>\n                </div>\n            </div>\n            <div class="speedscope-row">\n                <iframe id="speedscopeFrame" sandbox="allow-scripts allow-same-origin"/>\n            </div>\n\n            <script>\n                // --- DATA FROM SERVER ---\n                const memoryData = JSON.parse(atob('<t t-esc="memory_data"/>'));\n                const fullSpeedscopeBase64 = '<t t-esc="speedscope_base64"/>';\n                const cdn = '<t t-esc="cdn"/>';\n                const points = memoryData.points;\n\n                // --- UTILITY ---\n                function formatBytes(bytes) {\n                    if (bytes === 0) return '0 B';\n                    const k = 1024;\n                    const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];\n                    const i = Math.floor(Math.log(Math.abs(bytes)) / Math.log(k));\n                    const sign = bytes &lt; 0 ? '-' : '';\n                    return sign + (Math.abs(bytes) / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i];\n                }\n\n                function formatTimestamp(ts) {\n                    return new Date(ts * 1000).toLocaleTimeString();\n                }\n\n                // --- SPEEDSCOPE IFRAME ---\n                let currentBlobUrl = null;\n\n                function loadSpeedscopeInIframe(base64Data) {\n                    if (currentBlobUrl) URL.revokeObjectURL(currentBlobUrl);\n\n                    const html = '\\x3c!DOCTYPE html\\x3e' +\n                        '\\x3chtml\\x3e\\x3chead\\x3e' +\n                        '\\x3cscript\\x3ewindow.location.hash="#localProfilePath=1";\\x3c/script\\x3e' +\n                        '\\x3clink href="https://fonts.googleapis.com/css?family=Source+Code+Pro" rel="stylesheet"/\\x3e' +\n                        '\\x3clink rel="stylesheet" href="' + cdn + 'reset.8c46b7a1.css"/\\x3e' +\n                        '\\x3c/head\\x3e\\x3cbody\\x3e' +\n                        '\\x3cscript src="' + cdn + 'speedscope.026f36b0.js"\\x3e\\x3c/script\\x3e' +\n                        '\\x3cscript\\x3e' +\n                        'document.addEventListener("DOMContentLoaded", function() {' +\n                        '  speedscope.loadFileFromBase64("Profile", "' + base64Data + '");' +\n                        '});' +\n                        '\\x3c/script\\x3e' +\n                        '\\x3c/body\\x3e\\x3c/html\\x3e';\n\n                    const blob = new Blob([html], {type: 'text/html'});\n                    currentBlobUrl = URL.createObjectURL(blob);\n                    document.getElementById('speedscopeFrame').src = currentBlobUrl;\n                }\n\n                // --- CHART (hover-only, no click interaction) ---\n                const labels = points.map(p =&gt; formatTimestamp(p.timestamp));\n                const memValues = points.map(p =&gt; p.memory);\n\n                new Chart(document.getElementById('memoryChart'), {\n                    type: 'line',\n                    data: {\n                        labels: labels,\n                        datasets: [{\n                            label: 'RSS Memory (baselined)',\n                            data: memValues,\n                            fill: true,\n                            backgroundColor: 'rgba(75, 192, 192, 0.1)',\n                            borderColor: 'rgba(75, 192, 192, 1)',\n                            tension: 0.1,\n                            pointRadius: 2,\n                            pointBackgroundColor: 'rgba(75, 192, 192, 1)',\n                        }]\n                    },\n                    options: {\n                        responsive: true,\n                        maintainAspectRatio: false,\n                        plugins: {\n                            title: { display: true, text: 'RSS Memory Over Time' },\n                            tooltip: {\n                                callbacks: {\n                                    label: ctx =&gt; 'Δ ' + formatBytes(ctx.raw),\n                                    afterLabel: ctx =&gt; 'Absolute: ' + formatBytes(points[ctx.dataIndex].abs_memory),\n                                }\n                            },\n                            legend: { display: false },\n                        },\n                        scales: {\n                            y: {\n                                title: { display: true, text: 'Memory (Δ from baseline)' },\n                                ticks: { callback: v =&gt; formatBytes(v) },\n                            },\n                            x: {\n                                title: { display: true, text: 'Time' },\n                                ticks: { maxTicksLimit: 20 },\n                            }\n                        }\n                    }\n                });\n\n                // Load full memory speedscope\n                loadSpeedscopeInIframe(fullSpeedscopeBase64);\n            </script>\n        </body>\n        </html>\n    </t>\n	f	t	2026-09-09 14:26:22.945456	2026-09-09 14:26:22.945456
222	16	\N	1	1	config_speedscope_index	\N	web.config_speedscope_index	qweb	web/views/speedscope_config_wizard.xml	primary	{"en_US": "<t t-name=\\"web.config_speedscope_index\\">\\n        <link rel=\\"stylesheet\\" href=\\"/web/assets/any/web.assets_web.min.css\\"/>\\n        <script src=\\"/web/assets/any/web.assets_web.min.js\\" type=\\"text/javascript\\"/>\\n        <div class=\\"container-md p-0\\">\\n            <div class=\\"o_form_view align-items-center\\">\\n                <div class=\\"row\\">\\n                    <div class=\\"col\\">\\n                        <div class=\\"o_form_sheet\\">\\n                            <!-- Single Form -->\\n                            <form method=\\"get\\" t-attf-action=\\"/web/speedscope/{{profile_str}}\\">\\n                                <h4>Speedscope</h4>\\n                                <div class=\\"form-check\\">\\n                                    <input type=\\"checkbox\\" class=\\"form-check-input\\" id=\\"constant_time\\" name=\\"constant_time\\" value=\\"True\\"/>\\n                                    <label class=\\"form-check-label\\" for=\\"constant_time\\">Constant Time</label>\\n                                </div>\\n                                <!-- add more variable here -->\\n                                <div class=\\"form-check\\">\\n                                    <input type=\\"checkbox\\" class=\\"form-check-input\\" id=\\"aggregate_sql\\" name=\\"aggregate_sql\\" value=\\"True\\"/>\\n                                    <label class=\\"form-check-label\\" for=\\"aggregate_sql\\">Aggregate SQL</label>\\n                                </div>\\n                                <div class=\\"form-check\\">\\n                                    <input type=\\"checkbox\\" class=\\"form-check-input\\" id=\\"use_execution_context\\" name=\\"use_execution_context\\" value=\\"True\\" checked=\\"1\\"/>\\n                                    <label class=\\"form-check-label\\" for=\\"use_execution_context\\">Use execution context</label>\\n                                </div>\\n                                <div t-if=\\"len(profiles) &gt; 1\\">\\n                                <hr/>\\n                                <h4>Multiple profile</h4>\\n                                    <label class=\\"form-check-label\\" for=\\"profile_aggregation_mode\\">Aggregation mode</label>\\n                                    <select class=\\"form-select\\" name=\\"profile_aggregation_mode\\" id=\\"profile_aggregation_mode\\">\\n                                        <option value=\\"tabs\\">Separated (one per tab)</option>\\n                                        <option value=\\"temporal\\">Temporal (experimental)</option>\\n                                    </select>\\n                                    <span id=\\"temporal_warning\\" class=\\"alert alert-warning\\" style=\\"display:none\\"><b>Warning:</b> Temporal mode will merge all samples.<br/>It can lead to partially invalid result in case of concurrent profiles.<br/>Use with caution </span>\\n                                    <script>\\n                                        document.getElementById('profile_aggregation_mode').addEventListener('change', function (event) {\\n                                            document.getElementById('temporal_warning').style.display = event.target.value === 'temporal'? 'block': 'none';\\n                                        });\\n                                    </script>\\n\\n                                </div>\\n                                <hr/>\\n                                <h4>Display presets</h4>\\n                                <t t-set=\\"has_sql\\" t-value=\\"any(profile.sql for profile in profiles)\\"/>\\n                                <t t-set=\\"has_traces\\" t-value=\\"any(profile.traces_async for profile in profiles)\\"/>\\n                                <div class=\\"form-check\\" t-if=\\"has_sql and has_traces\\">\\n                                    <input type=\\"checkbox\\" class=\\"form-check-input\\" id=\\"combined_profile\\" name=\\"combined_profile\\" value=\\"True\\" t-att-checked=\\"default_params.get('combined_profile')\\"/>\\n                                    <label class=\\"form-check-label\\" for=\\"combined_profile\\">Frames + sql (Combined)</label>\\n                                </div>\\n                                <div class=\\"form-check\\" t-if=\\"has_sql\\">\\n                                    <input type=\\"checkbox\\" class=\\"form-check-input\\" id=\\"sql_no_gap_profile\\" name=\\"sql_no_gap_profile\\" value=\\"True\\" t-att-checked=\\"default_params.get('sql_no_gap_profile')\\"/>\\n                                    <label class=\\"form-check-label\\" for=\\"sql_no_gap_profile\\">SQL no gap</label>\\n                                </div>\\n                                <div class=\\"form-check\\" t-if=\\"has_sql\\">\\n                                    <input type=\\"checkbox\\" class=\\"form-check-input\\" id=\\"sql_density_profile\\" name=\\"sql_density_profile\\" value=\\"True\\" t-att-checked=\\"default_params.get('sql_density_profile')\\"/>\\n                                    <label class=\\"form-check-label\\" for=\\"sql_density_profile\\">SQL density</label>\\n                                </div>\\n                                <div class=\\"form-check\\" t-if=\\"has_traces\\">\\n                                    <input type=\\"checkbox\\" class=\\"form-check-input\\" id=\\"frames_profile\\" name=\\"frames_profile\\" value=\\"True\\" t-att-checked=\\"default_params.get('frames_profile')\\"/>\\n                                    <label class=\\"form-check-label\\" for=\\"frames_profile\\">Frames</label>\\n                                </div>\\n                                <div class=\\"form-check\\" t-if=\\"has_traces and profiles._has_memory_traces()\\">\\n                                    <input type=\\"checkbox\\" class=\\"form-check-input\\" id=\\"memory_profile\\" name=\\"memory_profile\\" value=\\"True\\" t-att-checked=\\"default_params.get('memory_profile')\\"/>\\n                                    <label class=\\"form-check-label\\" for=\\"memory_profile\\">Memory (heuristic)</label>\\n                                </div>\\n\\n                                <input type=\\"hidden\\" name=\\"profile_id\\" t-att-value=\\"profile_str\\"/>\\n                                \\n                                <div class=\\"mt-3\\">\\n                                    <button type=\\"submit\\" class=\\"btn btn-secondary\\" name=\\"action\\" value=\\"speedscope_download_json\\"><i class=\\"fa fa-download\\"/> (json)</button>\\n                                    <button type=\\"submit\\" class=\\"btn btn-secondary\\" name=\\"action\\" value=\\"speedscope_download_html\\"><i class=\\"fa fa-download\\"/> (html)</button>\\n                                    <button type=\\"submit\\" class=\\"btn btn-primary\\" name=\\"action\\" value=\\"speedscope_open\\">Open</button>\\n                                </div>\\n                            </form>\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t t-name="web.config_speedscope_index">\n        <link rel="stylesheet" href="/web/assets/any/web.assets_web.min.css"/>\n        <script src="/web/assets/any/web.assets_web.min.js" type="text/javascript"/>\n        <div class="container-md p-0">\n            <div class="o_form_view align-items-center">\n                <div class="row">\n                    <div class="col">\n                        <div class="o_form_sheet">\n                            <!-- Single Form -->\n                            <form method="get" t-attf-action="/web/speedscope/{{profile_str}}">\n                                <h4>Speedscope</h4>\n                                <div class="form-check">\n                                    <input type="checkbox" class="form-check-input" id="constant_time" name="constant_time" value="True"/>\n                                    <label class="form-check-label" for="constant_time">Constant Time</label>\n                                </div>\n                                <!-- add more variable here -->\n                                <div class="form-check">\n                                    <input type="checkbox" class="form-check-input" id="aggregate_sql" name="aggregate_sql" value="True"/>\n                                    <label class="form-check-label" for="aggregate_sql">Aggregate SQL</label>\n                                </div>\n                                <div class="form-check">\n                                    <input type="checkbox" class="form-check-input" id="use_execution_context" name="use_execution_context" value="True" checked="1"/>\n                                    <label class="form-check-label" for="use_execution_context">Use execution context</label>\n                                </div>\n                                <div t-if="len(profiles) &gt; 1">\n                                <hr/>\n                                <h4>Multiple profile</h4>\n                                    <label class="form-check-label" for="profile_aggregation_mode">Aggregation mode</label>\n                                    <select class="form-select" name="profile_aggregation_mode" id="profile_aggregation_mode">\n                                        <option value="tabs">Separated (one per tab)</option>\n                                        <option value="temporal">Temporal (experimental)</option>\n                                    </select>\n                                    <span id="temporal_warning" class="alert alert-warning" style="display:none"><b>Warning:</b> Temporal mode will merge all samples.<br/>It can lead to partially invalid result in case of concurrent profiles.<br/>Use with caution </span>\n                                    <script>\n                                        document.getElementById('profile_aggregation_mode').addEventListener('change', function (event) {\n                                            document.getElementById('temporal_warning').style.display = event.target.value === 'temporal'? 'block': 'none';\n                                        });\n                                    </script>\n\n                                </div>\n                                <hr/>\n                                <h4>Display presets</h4>\n                                <t t-set="has_sql" t-value="any(profile.sql for profile in profiles)"/>\n                                <t t-set="has_traces" t-value="any(profile.traces_async for profile in profiles)"/>\n                                <div class="form-check" t-if="has_sql and has_traces">\n                                    <input type="checkbox" class="form-check-input" id="combined_profile" name="combined_profile" value="True" t-att-checked="default_params.get('combined_profile')"/>\n                                    <label class="form-check-label" for="combined_profile">Frames + sql (Combined)</label>\n                                </div>\n                                <div class="form-check" t-if="has_sql">\n                                    <input type="checkbox" class="form-check-input" id="sql_no_gap_profile" name="sql_no_gap_profile" value="True" t-att-checked="default_params.get('sql_no_gap_profile')"/>\n                                    <label class="form-check-label" for="sql_no_gap_profile">SQL no gap</label>\n                                </div>\n                                <div class="form-check" t-if="has_sql">\n                                    <input type="checkbox" class="form-check-input" id="sql_density_profile" name="sql_density_profile" value="True" t-att-checked="default_params.get('sql_density_profile')"/>\n                                    <label class="form-check-label" for="sql_density_profile">SQL density</label>\n                                </div>\n                                <div class="form-check" t-if="has_traces">\n                                    <input type="checkbox" class="form-check-input" id="frames_profile" name="frames_profile" value="True" t-att-checked="default_params.get('frames_profile')"/>\n                                    <label class="form-check-label" for="frames_profile">Frames</label>\n                                </div>\n                                <div class="form-check" t-if="has_traces and profiles._has_memory_traces()">\n                                    <input type="checkbox" class="form-check-input" id="memory_profile" name="memory_profile" value="True" t-att-checked="default_params.get('memory_profile')"/>\n                                    <label class="form-check-label" for="memory_profile">Memory (heuristic)</label>\n                                </div>\n\n                                <input type="hidden" name="profile_id" t-att-value="profile_str"/>\n                                \n                                <div class="mt-3">\n                                    <button type="submit" class="btn btn-secondary" name="action" value="speedscope_download_json"><i class="fa fa-download"/> (json)</button>\n                                    <button type="submit" class="btn btn-secondary" name="action" value="speedscope_download_html"><i class="fa fa-download"/> (html)</button>\n                                    <button type="submit" class="btn btn-primary" name="action" value="speedscope_open">Open</button>\n                                </div>\n                            </form>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </t>\n	f	t	2026-09-09 14:26:22.945456	2026-09-09 14:26:22.945456
