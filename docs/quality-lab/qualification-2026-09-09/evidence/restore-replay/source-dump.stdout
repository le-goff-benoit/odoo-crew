171	16	\N	1	1	API Key: description input form	res.users.apikeys.description	\N	form	base/views/res_users_views.xml	primary	{"en_US": "<form>\\n                    <sheet>\\n                    <h3 class=\\"fw-bold\\">\\n                        Name your key\\n                    </h3>\\n                    <p>Enter a description of and purpose for the key.</p>\\n                    <field name=\\"name\\" placeholder=\\"What's this key for?\\"/>\\n                    <p>\\n                        It is very important that this description be clear\\n                        and complete, <strong>it will be the only way to\\n                        identify the key once created</strong>.\\n                    </p>\\n                    <h3 class=\\"fw-bold\\">\\n                        Give a duration for the key's validity\\n                    </h3>\\n                    <field name=\\"duration\\"/>\\n                    <field name=\\"expiration_date\\" invisible=\\"duration != '-1'\\"/>\\n                    <p>\\n                        The key will be deleted once this period has elapsed.\\n                    </p>\\n                    <footer>\\n                        <button name=\\"make_key\\" type=\\"object\\" string=\\"Generate key\\" class=\\"btn-primary\\" data-hotkey=\\"q\\"/>\\n                        <button special=\\"cancel\\" data-hotkey=\\"x\\" string=\\"Cancel\\" class=\\"btn-secondary\\"/>\\n                    </footer>\\n                    </sheet>\\n                </form>"}	<?xml version="1.0"?>\n<form>\n                    <sheet>\n                    <h3 class="fw-bold">\n                        Name your key\n                    </h3>\n                    <p>Enter a description of and purpose for the key.</p>\n                    <field name="name" placeholder="What's this key for?"/>\n                    <p>\n                        It is very important that this description be clear\n                        and complete, <strong>it will be the only way to\n                        identify the key once created</strong>.\n                    </p>\n                    <h3 class="fw-bold">\n                        Give a duration for the key's validity\n                    </h3>\n                    <field name="duration"/>\n                    <field name="expiration_date" invisible="duration != '-1'"/>\n                    <p>\n                        The key will be deleted once this period has elapsed.\n                    </p>\n                    <footer>\n                        <button name="make_key" type="object" string="Generate key" class="btn-primary" data-hotkey="q"/>\n                        <button special="cancel" data-hotkey="x" string="Cancel" class="btn-secondary"/>\n                    </footer>\n                    </sheet>\n                </form>\n            	f	t	2026-09-09 14:26:16.143585	2026-09-09 14:26:16.143585
