109	16	\N	1	1	Uninstall module	base.module.uninstall	\N	form	base/wizard/base_module_uninstall_views.xml	primary	{"en_US": "<form string=\\"Uninstall module\\">\\n                    <div class=\\"alert alert-warning oe_button_box\\" role=\\"alert\\">\\n                        <p class=\\"mt-3\\">\\n                            Uninstalling modules can be risky, we recommend you to try it on a duplicate or test database first.\\n                        </p>\\n                    </div>\\n                    <div class=\\"d-flex bd-highlight\\">\\n                        <div class=\\"me-auto p-2 bd-highlight\\"><h3>Apps to Uninstall</h3></div>\\n                        <div class=\\"p-2 bd-highlight\\"><field name=\\"show_all\\"/> Show All</div>\\n                    </div>\\n                    <field name=\\"impacted_module_ids\\" mode=\\"kanban\\" class=\\"o_modules_field\\">\\n                        <kanban create=\\"false\\" class=\\"o_modules_kanban\\">\\n                            <field name=\\"state\\"/>\\n                                <templates>\\n                                    <t t-name=\\"card\\" class=\\"flex-row align-items-center\\">\\n                                        <aside>\\n                                            <field name=\\"icon\\" widget=\\"image_url\\" options=\\"{'size': [50, 50]}\\" alt=\\"Icon\\"/>\\n                                        </aside>\\n                                        <main t-att-title=\\"record.shortdesc.value\\">\\n                                            <field class=\\"fw-bold fs-5 mb-0\\" name=\\"shortdesc\\"/>\\n                                            <p class=\\"text-muted small my-1 lh-sm\\">\\n                                                <field groups=\\"!base.group_no_one\\" name=\\"summary\\"/>\\n                                                <code groups=\\"base.group_no_one\\">\\n                                                    <field name=\\"name\\"/>\\n                                                </code>\\n                                            </p>\\n                                        </main>\\n                                    </t>\\n                                </templates>\\n                        </kanban>\\n                    </field>\\n                    <h3>Documents to Delete</h3>\\n                    <field name=\\"model_ids\\" string=\\"Models\\" nolabel=\\"1\\">\\n                        <list string=\\"Models\\">\\n                            <field name=\\"name\\" string=\\"Document\\"/>\\n                            <field name=\\"count\\"/>\\n                        </list>\\n                    </field>\\n                    <footer>\\n                        <button string=\\"Uninstall\\" class=\\"btn-secondary\\" type=\\"object\\" name=\\"action_uninstall\\" data-hotkey=\\"q\\"/>\\n                        <button string=\\"Discard\\" class=\\"btn-primary\\" special=\\"cancel\\" data-hotkey=\\"x\\"/>\\n                    </footer>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Uninstall module">\n                    <div class="alert alert-warning oe_button_box" role="alert">\n                        <p class="mt-3">\n                            Uninstalling modules can be risky, we recommend you to try it on a duplicate or test database first.\n                        </p>\n                    </div>\n                    <div class="d-flex bd-highlight">\n                        <div class="me-auto p-2 bd-highlight"><h3>Apps to Uninstall</h3></div>\n                        <div class="p-2 bd-highlight"><field name="show_all"/> Show All</div>\n                    </div>\n                    <field name="impacted_module_ids" mode="kanban" class="o_modules_field">\n                        <kanban create="false" class="o_modules_kanban">\n                            <field name="state"/>\n                                <templates>\n                                    <t t-name="card" class="flex-row align-items-center">\n                                        <aside>\n                                            <field name="icon" widget="image_url" options="{'size': [50, 50]}" alt="Icon"/>\n                                        </aside>\n                                        <main t-att-title="record.shortdesc.value">\n                                            <field class="fw-bold fs-5 mb-0" name="shortdesc"/>\n                                            <p class="text-muted small my-1 lh-sm">\n                                                <field groups="!base.group_no_one" name="summary"/>\n                                                <code groups="base.group_no_one">\n                                                    <field name="name"/>\n                                                </code>\n                                            </p>\n                                        </main>\n                                    </t>\n                                </templates>\n                        </kanban>\n                    </field>\n                    <h3>Documents to Delete</h3>\n                    <field name="model_ids" string="Models" nolabel="1">\n                        <list string="Models">\n                            <field name="name" string="Document"/>\n                            <field name="count"/>\n                        </list>\n                    </field>\n                    <footer>\n                        <button string="Uninstall" class="btn-secondary" type="object" name="action_uninstall" data-hotkey="q"/>\n                        <button string="Discard" class="btn-primary" special="cancel" data-hotkey="x"/>\n                    </footer>\n                </form>\n            	f	t	2026-09-09 14:26:16.143585	2026-09-09 14:26:16.143585
115	16	\N	1	1	IR Profile List	ir.profile	\N	list	base/views/ir_profile_views.xml	primary	{"en_US": "<list string=\\"Profile Session\\" default_order=\\"session desc, id desc\\" create=\\"0\\">\\n                <header>\\n                    <button name=\\"action_view_speedscope\\" type=\\"object\\" string=\\"View in speedscope\\"/>\\n                </header>\\n                <field name=\\"create_date\\"/>\\n                <field name=\\"session\\"/>\\n                <field name=\\"name\\"/>\\n                <field name=\\"entry_count\\"/>\\n                <field name=\\"sql_count\\" optional=\\"hide\\"/>\\n                <field name=\\"speedscope_url\\" widget=\\"url\\"/>\\n                <field name=\\"config_url\\" widget=\\"url\\"/>\\n                <field name=\\"duration\\"/>\\n                <field name=\\"cpu_duration\\" optional=\\"hide\\"/>\\n            </list>"}	<?xml version="1.0"?>\n<list string="Profile Session" default_order="session desc, id desc" create="0">\n                <header>\n                    <button name="action_view_speedscope" type="object" string="View in speedscope"/>\n                </header>\n                <field name="create_date"/>\n                <field name="session"/>\n                <field name="name"/>\n                <field name="entry_count"/>\n                <field name="sql_count" optional="hide"/>\n                <field name="speedscope_url" widget="url"/>\n                <field name="config_url" widget="url"/>\n                <field name="duration"/>\n                <field name="cpu_duration" optional="hide"/>\n            </list>\n        	f	t	2026-09-09 14:26:16.143585	2026-09-09 14:26:16.143585
110	16	\N	1	1	Export Translations	base.language.export	\N	form	base/wizard/base_export_language_views.xml	primary	{"en_US": "<form string=\\"Export Translations\\">\\n                    <field name=\\"name\\" invisible=\\"1\\"/> <!-- The name is needed in the BinaryField component used to download the file -->\\n                    <group invisible=\\"state != 'choose'\\" string=\\"Export Settings\\">\\n                        <field name=\\"lang\\"/>\\n                        <field name=\\"format\\"/>\\n                        <field name=\\"export_type\\"/>\\n                        <field name=\\"modules\\" widget=\\"many2many_tags\\" options=\\"{'no_create': True}\\" invisible=\\"export_type == 'model'\\"/>\\n                        <field name=\\"model_id\\" options=\\"{'no_create': True}\\" invisible=\\"export_type == 'module'\\" required=\\"export_type == 'model'\\"/>\\n                        <field name=\\"model_name\\" invisible=\\"1\\"/> <!-- The model_name is needed for the option of the domain -->\\n                        <field name=\\"domain\\" widget=\\"domain\\" options=\\"{'model': 'model_name'}\\" invisible=\\"export_type == 'module'\\"/>\\n                    </group>\\n                    <div invisible=\\"state != 'get'\\">\\n                        <h2>Export Complete</h2>\\n                        <div invisible=\\"data\\">\\n                            <div class=\\"mb-2 rounded-2 overflow-hidden d-grid gap-2\\">\\n                                <div class=\\"alert alert-warning m-0 p-1 ps-3\\" role=\\"alert\\">\\n                                    <div name=\\"error\\" style=\\"white-space: pre-wrap;\\" invisible=\\"export_type == 'module'\\">\\n                                        Model\\n                                        <field name=\\"model_id\\" readonly=\\"1\\"/>\\n                                        does not contain translatable terms.<br/>\\n                                    </div>\\n                                    <div name=\\"error\\" style=\\"white-space: pre-wrap;\\" invisible=\\"export_type == 'model'\\">\\n                                        Modules\\n                                        <field name=\\"modules\\" widget=\\"many2many_tags\\" readonly=\\"1\\"/>\\n                                        do not contain translatable terms.<br/>\\n                                    </div>\\n                                </div>\\n                            </div>\\n                            No file could be exported.\\n                        </div>\\n                        <div invisible=\\"not data\\">\\n                            <p>Here is the exported translation file: <field name=\\"data\\" readonly=\\"1\\" filename=\\"name\\"/></p>\\n                            <p>This file was generated using the universal <strong>Unicode/UTF-8</strong> file encoding, please be sure to view and edit\\n                               using the same encoding.</p>\\n                            <p>The next step depends on the file format:\\n                                <ul>\\n                                <li>CSV format: you may edit it directly with your favorite spreadsheet software,\\n                                    the rightmost column (value) contains the translations</li>\\n                                <li>PO(T) format: you should edit it with a PO editor such as\\n                                    <a href=\\"http://www.poedit.net/\\" target=\\"_blank\\">POEdit</a>, or your preferred text editor</li>\\n                                <li>TGZ format: bundles multiple PO(T) files as a single archive</li>\\n                                </ul>\\n                            </p>\\n                            <p>For more details about translating Odoo in your language, please refer to the\\n                                <a href=\\"https://github.com/odoo/odoo/wiki/Translations\\" target=\\"_blank\\">documentation</a>.</p>\\n                        </div>\\n                    </div>\\n                    <footer invisible=\\"state != 'choose'\\">\\n                        <button name=\\"act_getfile\\" data-hotkey=\\"q\\" string=\\"Export\\" type=\\"object\\" class=\\"btn-primary\\"/>\\n                        <button special=\\"cancel\\" data-hotkey=\\"x\\" string=\\"Cancel\\" type=\\"object\\" class=\\"btn-secondary\\"/>\\n                    </footer>\\n                    <footer invisible=\\"state != 'get'\\">\\n                        <button special=\\"cancel\\" data-hotkey=\\"x\\" string=\\"Close\\" type=\\"object\\" class=\\"btn-primary\\"/>\\n                    </footer>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Export Translations">\n                    <field name="name" invisible="1"/> <!-- The name is needed in the BinaryField component used to download the file -->\n                    <group invisible="state != 'choose'" string="Export Settings">\n                        <field name="lang"/>\n                        <field name="format"/>\n                        <field name="export_type"/>\n                        <field name="modules" widget="many2many_tags" options="{'no_create': True}" invisible="export_type == 'model'"/>\n                        <field name="model_id" options="{'no_create': True}" invisible="export_type == 'module'" required="export_type == 'model'"/>\n                        <field name="model_name" invisible="1"/> <!-- The model_name is needed for the option of the domain -->\n                        <field name="domain" widget="domain" options="{'model': 'model_name'}" invisible="export_type == 'module'"/>\n                    </group>\n                    <div invisible="state != 'get'">\n                        <h2>Export Complete</h2>\n                        <div invisible="data">\n                            <div class="mb-2 rounded-2 overflow-hidden d-grid gap-2">\n                                <div class="alert alert-warning m-0 p-1 ps-3" role="alert">\n                                    <div name="error" style="white-space: pre-wrap;" invisible="export_type == 'module'">\n                                        Model\n                                        <field name="model_id" readonly="1"/>\n                                        does not contain translatable terms.<br/>\n                                    </div>\n                                    <div name="error" style="white-space: pre-wrap;" invisible="export_type == 'model'">\n                                        Modules\n                                        <field name="modules" widget="many2many_tags" readonly="1"/>\n                                        do not contain translatable terms.<br/>\n                                    </div>\n                                </div>\n                            </div>\n                            No file could be exported.\n                        </div>\n                        <div invisible="not data">\n                            <p>Here is the exported translation file: <field name="data" readonly="1" filename="name"/></p>\n                            <p>This file was generated using the universal <strong>Unicode/UTF-8</strong> file encoding, please be sure to view and edit\n                               using the same encoding.</p>\n                            <p>The next step depends on the file format:\n                                <ul>\n                                <li>CSV format: you may edit it directly with your favorite spreadsheet software,\n                                    the rightmost column (value) contains the translations</li>\n                                <li>PO(T) format: you should edit it with a PO editor such as\n                                    <a href="http://www.poedit.net/" target="_blank">POEdit</a>, or your preferred text editor</li>\n                                <li>TGZ format: bundles multiple PO(T) files as a single archive</li>\n                                </ul>\n                            </p>\n                            <p>For more details about translating Odoo in your language, please refer to the\n                                <a href="https://github.com/odoo/odoo/wiki/Translations" target="_blank">documentation</a>.</p>\n                        </div>\n                    </div>\n                    <footer invisible="state != 'choose'">\n                        <button name="act_getfile" data-hotkey="q" string="Export" type="object" class="btn-primary"/>\n                        <button special="cancel" data-hotkey="x" string="Cancel" type="object" class="btn-secondary"/>\n                    </footer>\n                    <footer invisible="state != 'get'">\n                        <button special="cancel" data-hotkey="x" string="Close" type="object" class="btn-primary"/>\n                    </footer>\n                </form>\n            	f	t	2026-09-09 14:26:16.143585	2026-09-09 14:26:16.143585
111	16	\N	1	1	base.partner.merge.automatic.wizard.form	base.partner.merge.automatic.wizard	\N	form	base/wizard/base_partner_merge_views.xml	primary	{"en_US": "<form string=\\"Automatic Merge Wizard\\" class=\\"o_partner_merge_wizard\\">\\n                    <sheet>\\n                        <group invisible=\\"state != 'finished'\\">\\n                            <h2 colspan=\\"2\\">There are no more contacts to merge for this request</h2>\\n                            <button name=\\"49\\" string=\\"Deduplicate the other Contacts\\" class=\\"oe_highlight\\" type=\\"action\\" colspan=\\"2\\"/>\\n                        </group>\\n                        <p class=\\"opacity-50\\" invisible=\\"state != 'option'\\">\\n                            Select the list of fields used to search for\\n                            duplicated records. If you select several fields,\\n                            Odoo will propose you to merge only those having\\n                            all these fields in common. (not one of the fields).\\n                        </p>\\n                        <group invisible=\\"state not in ('selection', 'finished') or number_group == 0\\">\\n                            <field name=\\"number_group\\"/>\\n                        </group>\\n                        <group string=\\"Search duplicates based on duplicated data in\\" invisible=\\"state not in ('option',)\\">\\n                            <field name=\\"group_by_email\\"/>\\n                            <field name=\\"group_by_name\\"/>\\n                            <field name=\\"group_by_is_company\\"/>\\n                            <field name=\\"group_by_vat\\"/>\\n                            <field name=\\"group_by_parent_id\\"/>\\n                        </group>\\n                        <group string=\\"Exclude contacts having\\" invisible=\\"state not in ('option',)\\">\\n                            <field name=\\"exclude_contact\\"/>\\n                            <field name=\\"exclude_journal_item\\"/>\\n                        </group>\\n                        <separator string=\\"Options\\" invisible=\\"state not in ('option',)\\"/>\\n                        <group invisible=\\"state not in ('option', 'finished')\\">\\n                            <field name=\\"maximum_group\\" readonly=\\"state == 'finished'\\"/>\\n                        </group>\\n                        <separator string=\\"Merge the following contacts\\" invisible=\\"state in ('option', 'finished')\\"/>\\n                        <group invisible=\\"state in ('option', 'finished')\\" col=\\"1\\">\\n                            <p class=\\"opacity-50\\">\\n                                Selected contacts will be merged together.\\n                                All documents linked to one of these contacts\\n                                will be redirected to the destination contact.\\n                                You can remove contacts from this list to avoid merging them.\\n                            </p>\\n                            <group col=\\"2\\">\\n                                <field name=\\"dst_partner_id\\" domain=\\"[('id', 'in', partner_ids or False)]\\" required=\\"state == 'selection'\\" context=\\"{'partner_show_db_id': True}\\"/>\\n                            </group>\\n                            <field name=\\"partner_ids\\" nolabel=\\"1\\">\\n                                <list string=\\"Partners\\">\\n                                    <field name=\\"id\\"/>\\n                                    <field name=\\"display_name\\"/>\\n                                    <field name=\\"email\\"/>\\n                                    <field name=\\"is_company\\"/>\\n                                    <field name=\\"vat\\"/>\\n                                    <field name=\\"country_id\\"/>\\n                                </list>\\n                            </field>\\n                        </group>\\n                    </sheet>\\n                    <footer>\\n                        <button name=\\"action_merge\\" string=\\"Merge Contacts\\" class=\\"oe_highlight\\" type=\\"object\\" data-hotkey=\\"q\\" invisible=\\"state in ('option', 'finished')\\"/>\\n                        <button name=\\"action_skip\\" string=\\"Skip these contacts\\" type=\\"object\\" invisible=\\"state != 'selection'\\"/>\\n                        <button name=\\"action_start_manual_process\\" string=\\"Merge with Manual Check\\" data-hotkey=\\"w\\" type=\\"object\\" class=\\"oe_highlight\\" invisible=\\"state != 'option'\\"/>\\n                        <button name=\\"action_start_automatic_process\\" string=\\"Merge Automatically\\" data-hotkey=\\"l\\" type=\\"object\\" class=\\"oe_highlight\\" confirm=\\"Are you sure to execute the automatic merge of your contacts?\\" invisible=\\"state != 'option'\\"/>\\n                        <button name=\\"action_update_all_process\\" string=\\"Merge Automatically all process\\" type=\\"object\\" data-hotkey=\\"y\\" confirm=\\"Are you sure to execute the list of automatic merges of your contacts?\\" invisible=\\"state != 'option'\\"/>\\n                        <button special=\\"cancel\\" data-hotkey=\\"x\\" string=\\"Cancel\\" type=\\"object\\" class=\\"btn btn-secondary oe_inline\\" invisible=\\"state == 'finished'\\"/>\\n                        <button special=\\"cancel\\" data-hotkey=\\"x\\" string=\\"Close\\" type=\\"object\\" class=\\"btn btn-secondary oe_inline\\" invisible=\\"state != 'finished'\\"/>\\n                    </footer>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Automatic Merge Wizard" class="o_partner_merge_wizard">\n                    <sheet>\n                        <group invisible="state != 'finished'">\n                            <h2 colspan="2">There are no more contacts to merge for this request</h2>\n                            <button name="49" string="Deduplicate the other Contacts" class="oe_highlight" type="action" colspan="2"/>\n                        </group>\n                        <p class="opacity-50" invisible="state != 'option'">\n                            Select the list of fields used to search for\n                            duplicated records. If you select several fields,\n                            Odoo will propose you to merge only those having\n                            all these fields in common. (not one of the fields).\n                        </p>\n                        <group invisible="state not in ('selection', 'finished') or number_group == 0">\n                            <field name="number_group"/>\n                        </group>\n                        <group string="Search duplicates based on duplicated data in" invisible="state not in ('option',)">\n                            <field name="group_by_email"/>\n                            <field name="group_by_name"/>\n                            <field name="group_by_is_company"/>\n                            <field name="group_by_vat"/>\n                            <field name="group_by_parent_id"/>\n                        </group>\n                        <group string="Exclude contacts having" invisible="state not in ('option',)">\n                            <field name="exclude_contact"/>\n                            <field name="exclude_journal_item"/>\n                        </group>\n                        <separator string="Options" invisible="state not in ('option',)"/>\n                        <group invisible="state not in ('option', 'finished')">\n                            <field name="maximum_group" readonly="state == 'finished'"/>\n                        </group>\n                        <separator string="Merge the following contacts" invisible="state in ('option', 'finished')"/>\n                        <group invisible="state in ('option', 'finished')" col="1">\n                            <p class="opacity-50">\n                                Selected contacts will be merged together.\n                                All documents linked to one of these contacts\n                                will be redirected to the destination contact.\n                                You can remove contacts from this list to avoid merging them.\n                            </p>\n                            <group col="2">\n                                <field name="dst_partner_id" domain="[('id', 'in', partner_ids or False)]" required="state == 'selection'" context="{'partner_show_db_id': True}"/>\n                            </group>\n                            <field name="partner_ids" nolabel="1">\n                                <list string="Partners">\n                                    <field name="id"/>\n                                    <field name="display_name"/>\n                                    <field name="email"/>\n                                    <field name="is_company"/>\n                                    <field name="vat"/>\n                                    <field name="country_id"/>\n                                </list>\n                            </field>\n                        </group>\n                    </sheet>\n                    <footer>\n                        <button name="action_merge" string="Merge Contacts" class="oe_highlight" type="object" data-hotkey="q" invisible="state in ('option', 'finished')"/>\n                        <button name="action_skip" string="Skip these contacts" type="object" invisible="state != 'selection'"/>\n                        <button name="action_start_manual_process" string="Merge with Manual Check" data-hotkey="w" type="object" class="oe_highlight" invisible="state != 'option'"/>\n                        <button name="action_start_automatic_process" string="Merge Automatically" data-hotkey="l" type="object" class="oe_highlight" confirm="Are you sure to execute the automatic merge of your contacts?" invisible="state != 'option'"/>\n            