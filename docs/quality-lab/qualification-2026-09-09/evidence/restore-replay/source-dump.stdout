17	16	\N	1	1	Server Action History Wizard	server.action.history.wizard	\N	form	base/views/ir_actions_views.xml	primary	{"en_US": "<form>\\n                    <group>\\n                        <group>\\n                            <field name=\\"revision\\" required=\\"1\\" widget=\\"selection\\"/>\\n                        </group>\\n                    </group>\\n                    <field name=\\"code_diff\\" invisible=\\"not code_diff\\"/>\\n                    <div class=\\"alert alert-warning my-2\\" role=\\"alert\\" invisible=\\"code_diff\\">\\n                        <span>No diff available</span>\\n                    </div>\\n                    <footer>\\n                        <button string=\\"Restore Revision\\" name=\\"restore_revision\\" type=\\"object\\" class=\\"btn-primary\\" invisible=\\"not code_diff\\" data-hotkey=\\"q\\"/>\\n                        <button string=\\"Cancel\\" class=\\"btn-secondary\\" special=\\"cancel\\" data-hotkey=\\"x\\"/>\\n                    </footer>\\n                </form>"}	<?xml version="1.0"?>\n<form>\n                    <group>\n                        <group>\n                            <field name="revision" required="1" widget="selection"/>\n                        </group>\n                    </group>\n                    <field name="code_diff" invisible="not code_diff"/>\n                    <div class="alert alert-warning my-2" role="alert" invisible="code_diff">\n                        <span>No diff available</span>\n                    </div>\n                    <footer>\n                        <button string="Restore Revision" name="restore_revision" type="object" class="btn-primary" invisible="not code_diff" data-hotkey="q"/>\n                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>\n                    </footer>\n                </form>\n            	f	t	2026-09-09 14:26:16.143585	2026-09-09 14:26:16.143585
18	16	\N	1	1	Server Action	ir.actions.server	\N	form	base/views/ir_actions_views.xml	primary	{"en_US": "<form string=\\"Server Action\\">\\n                    <header invisible=\\"context.get('is_modal')\\">\\n                        <button name=\\"create_action\\" string=\\"Create Contextual Action\\" type=\\"object\\" class=\\"btn-primary\\" invisible=\\"binding_model_id\\" help=\\"Display an option in the 'More' top-menu in order to run this action.\\"/>\\n                        <button name=\\"unlink_action\\" string=\\"Remove Contextual Action\\" type=\\"object\\" invisible=\\"not binding_model_id\\" help=\\"Remove 'More' top-menu contextual action related to this action\\"/>\\n                        <button name=\\"run\\" string=\\"Run\\" type=\\"object\\" class=\\"btn-primary\\" invisible=\\"model_name != 'ir.actions.server' or state != 'code'\\" help=\\"Run this action manually.\\"/>\\n                        <button name=\\"history_wizard_action\\" string=\\"Code History\\" type=\\"object\\" invisible=\\"not show_code_history\\" help=\\"View code history and restore a previous version\\"/>\\n                    </header>\\n                    <sheet>\\n                        <div class=\\"oe_button_box\\" name=\\"button_box\\">\\n                            <button type=\\"object\\" name=\\"action_open_parent_action\\" invisible=\\"not parent_id\\" class=\\"oe_stat_button\\" icon=\\"fa-database\\">\\n                                <div class=\\"o_stat_info\\">\\n                                    <span class=\\"o_stat_text\\">Parent Action</span>\\n                                </div>\\n                            </button>\\n                            <button type=\\"object\\" name=\\"action_open_scheduled_action\\" invisible=\\"not ir_cron_ids or context.key != 'server_action'\\" context=\\"{'key': 'ir_cron'}\\" class=\\"oe_stat_button\\" icon=\\"fa-refresh\\">\\n                                <div class=\\"o_stat_info\\">\\n                                    <span class=\\"o_stat_text\\">Scheduled Action</span>\\n                                </div>\\n                            </button>\\n                        </div>\\n                        <h1 class=\\"oe_title\\">\\n                            <field name=\\"automated_name\\" invisible=\\"1\\"/> <!-- needed for name compute -->\\n                            <field name=\\"name\\" placeholder=\\"Set an explicit name\\"/>\\n                        </h1>\\n                        <group invisible=\\"context.get('is_modal')\\">\\n                            <group>\\n                                <field name=\\"model_id\\" options=\\"{'no_create': True, 'no_open': True}\\" groups=\\"base.group_no_one\\"/>\\n                                <field name=\\"model_id\\" options=\\"{'no_create': True, 'no_open': True}\\" groups=\\"!base.group_no_one\\" invisible=\\"context.get('default_model_id')\\" domain=\\"[('id', 'in', available_model_ids)]\\"/>\\n                            </group>\\n                            <group groups=\\"base.group_no_one\\">\\n                                <field name=\\"group_ids\\" widget=\\"many2many_tags\\"/>\\n                            </group>\\n                        </group>\\n                        <t name=\\"action_content\\" invisible=\\"not model_id\\">\\n                            <field name=\\"allowed_states\\" invisible=\\"1\\"/> <!-- Used to filter state using selection_badge_with_filter -->\\n                            <div class=\\"d-flex flex-column\\">\\n                                <label for=\\"state\\"/>\\n                                <field name=\\"state\\" widget=\\"selection_badge_with_filter\\" options=\\"{'size': 'sm', 'allowed_selection_field': 'allowed_states'}\\"/>\\n                            </div>\\n                            <div class=\\"alert alert-warning\\" role=\\"alert\\" invisible=\\"not warning\\">\\n                                <i class=\\"fa fa-warning pe-2\\" title=\\"Warning\\"/><field class=\\"d-inline\\" name=\\"warning\\" nolabel=\\"1\\"/>\\n                            </div>\\n                            <div class=\\"d-flex flex-row flex-wrap gap-2\\" invisible=\\"state != 'object_write'\\">\\n                                <field name=\\"evaluation_type\\" class=\\"oe_inline\\"/>\\n                                <field name=\\"update_path\\" widget=\\"field_selector\\" class=\\"oe_inline\\" options=\\"{'model': 'model_name', 'allow_properties': False}\\" required=\\"state == 'object_write'\\"/>\\n                                <field name=\\"update_field_id\\" invisible=\\"True\\"/>  <!-- The field is store=True and readonly=False, in this view we want to save the value from compute/onchange -->\\n                                <field name=\\"update_related_model_id\\" invisible=\\"True\\"/> <!-- This field is required for 'resource_ref' to compute possible m2m and m2o values -->\\n                                <span invisible=\\"evaluation_type != 'value' or update_field_type not in ['one2many', 'many2many']\\">by</span>\\n                                <field name=\\"update_m2m_operation\\" class=\\"oe_inline\\" invisible=\\"evaluation_type != 'value' or update_field_type not in ['one2many', 'many2many']\\" required=\\"update_field_type in ['one2many', 'many2many']\\"/>\\n                                <span invisible=\\"evaluation_type != 'value' or update_field_type in ['one2many', 'many2many']\\">to</span>\\n                                <span invisible=\\"evaluation_type != 'sequence'\\">with</span>\\n                                <field name=\\"value\\" class=\\"oe_inline\\" placeholder=\\"Set a value...\\" invisible=\\"update_field_id == False or value_field_to_show != 'value' or evaluation_type != 'value'\\" string=\\"Custom Value\\"/>\\n                                <field name=\\"html_value\\" class=\\"w-100\\" placeholder=\\"Set a value...\\" invisible=\\"update_field_id == False or value_field_to_show != 'html_value' or evaluation_type != 'value'\\" string=\\"Custom Value\\"/>\\n                                <field name=\\"sequence_id\\" class=\\"oe_inline\\" placeholder=\\"Select a sequence...\\" invisible=\\"evaluation_type != 'sequence'\\" required=\\"evaluation_type == 'sequence'\\"/>\\n                                <field name=\\"resource_ref\\" class=\\"oe_inline\\" placeholder=\\"Choose a value...\\" string=\\"Custom Value\\" options=\\"{'model_field': 'update_related_model_id', 'no_create': True, 'no_open': True}\\" invisible=\\"update_field_id == False or value_field_to_show != 'resource_ref' or evaluation_type == 'equation' or update_m2m_operation == 'clear'\\"/>\\n                                <field name=\\"selection_value\\" class=\\"oe_inline\\" placeholder=\\"Choose a value...\\" options=\\"{'no_create': True, 'no_open': True}\\" invisible=\\"update_field_id == False or value_field_to_show != 'selection_value' or evaluation_type == 'equation'\\"/>\\n                                <field name=\\"update_boolean_value\\" class=\\"oe_inline\\" invisible=\\"evaluation_type != 'value' or value_field_to_show != 'update_boolean_value'\\" required=\\"value_field_to_show == 'update_boolean_value'\\"/>\\n                                <span invisible=\\"update_field_id != False or evaluation_type != 'value'\\" class=\\"o_actions_server_set_a_value text-muted\\">Set a value...</span>\\n                                <span invisible=\\"evaluation_type != 'equation'\\">\\n                                    to this Python expression:\\n                                </span>\\n                                <div class=\\"w-100 d-flex flex-row gap-3\\" invisible=\\"evaluation_type != 'equation'\\">\\n                                    <field name=\\"value\\" class=\\"w-50\\" widget=\\"code\\" options=\\"{'mode': 'python'}\\" string=\\"Expression\\"/>\\n                                    <div class=\\"w-50 opacity-75\\">\\n                                        <span colspan=\\"2\\" class=\\"text-muted\\"> Available variables: </span>\\n                                            <ul colspan=\\"2\\" class=\\"text-muted\\">\\n                                                <li><code>env</code>: environment on which the action is triggered</li>\\n                                                <li><code>model</code>: model of the record on which the action is triggered; is a void recordset</li>\\n                                                <li><code>record</code>: record on which the action is triggered</li>\\n                                                <li><code>records</code>: recordset of all records on which the action is triggered in multi mode</li>\\n                                                <li><code>time</code>, <code>datetime</code>, <code>dateutil</code>, <code>timezone</code>: useful Python libraries</li>\\n                                                <li><code>float_compare()</code>: utility function to compare floats based on a specific precision</li>\\n                                            </ul>\\n                                    </div>\\n                                </div>\\n                            </div>\\n                            <group invisible=\\"state not in ['object_create', 'object_copy']\\">\\n                                <group>\\n                                    <field name=\\"crud_model_id\\" options=\\"{'no_create': True, 'no_open': True}\\" required=\\"state in ['object_create', 'object_copy']\\"/>\\n                                    <field name=\\"value\\" widget=\\"char\\" string=\\"Name\\" invisible=\\"state != 'object_create'\\" help=\\"The name of the record to create\\" placeholder=\\"e.g. Follow-up\\"/>\\n                                    <field name=\\"resource_ref\\" placeholder=\\"Choose a record...\\" string=\\"Duplicate from\\" options=\\"{'model_field': 'crud_model_id', 'no_create': True, 'no_open': True}\\" invisible=\\"crud_model_id == False or state != 'object_copy'\\" required=\\"state == 'object_copy'\\"/>\\n                                    <field name=\\"link_field_id\\" domain=\\"[('model_id', '=', model_id), ('relation', '=', crud_model_name),                                         ('ttype', 'in', ['many2one', 'one2many', 'many2many'])]\\" placeholder=\\"Select a field to link the record to\\" options=\\"{'no_create': True, 'no_open': True}\\" context=\\"{'default_model_id': model_id, 'default_relation': crud_model_name}\\"/>\\n                                </group>\\n                            </group>\\n                            <group invisible=\\"state != 'webhook'\\">\\n                                <group>\\n                                    <field name=\\"webhook_url\\" string=\\"URL\\" placeholder=\\"e.g. https://maker.ifttt.com/use/...\\"/>\\n                                    <field name=\\"webhook_field_ids\\" string=\\"Fields\\" widget=\\"many2many_tags\\" context=\\"{'hide_model': 1}\\" domain=\\"[('model_id', '=', model_id)]\\" placeholder=\\"Select fields to include in the request...\\"/>\\n                                </group>\\n                                <group>\\n                                    <label for=\\"webhook_sample_payload\\"/>\\n                                    <field name=\\"webhook_sample_payload\\" string=\\"Sample Payload\\" nolabel=\\"1\\" colspan=\\"2\\" readonly=\\"1\\" widget=\\"code\\" options=\\"{'mode': 'javascript'}\\"/>\\n                                </group>\\n                            </group>\\n                            <t invisible=\\"state != 'multi'\\">\\n                                <field name=\\"child_ids\\" widget=\\"many2many\\" mode=\\"kanban\\" context=\\"{                                     'is_modal': 1,                                     'default_model_id': model_id,                                 }\\"/>\\n                            </t>\\n                            <notebook>\\n                                <page string=\\"Code\\" invisible=\\"state != 'code'\\">\\n                                    <field name=\\"code\\" invisible=\\"state != 'code'\\" widget=\\"code\\" options=\\"{'mode': 'python'}\\" placeholder=\\"Enter Python code here. Help about Python expression is available in the help tab of this document.\\"/>\\n                                </page>\\n                                <page string=\\"Help\\" invisible=\\"state != 'code'\\" name=\\"ir_actions_server_code_help\\">\\n                                    <p>The following variables can be used:</p>\\n                                    <ul>\\n                                        <li><code>env</code>: environment on which the action is triggered</li>\\n                                        <li><code>model</code>: model of the record on which the action is triggered; is a void recordset</li>\\n                                        <li><code>record</code>: record on which the action is triggered; may be be void</li>\\n                                        <li><code>records</code>: recordset of all records on which the action is triggered in multi mode; may be void</li>\\n                                        <li><code>time</code>, <code>datetime</code>, <code>dateutil</code>, <code>timezone</code>: useful Python libraries</li>\\n                                        <li><code>float_compare()</code>: utility function to compare floats based on a specific precision</li>\\n                                        <li><code>log(message, level='info')</code>: logging function to record debug information in <code>ir.logging</code> table</li>\\n                                        <li><code>_logger.info(message)</code>: logger to emit messages in server logs</li>\\n                                        <li><code>UserError</code>: exception class for raising user-facing warning messages</li>\\n                                        <li><code>Command</code>: x2many commands namespace</li>\\n                                        <li>To return an action, assign: <code>action = {...}</code></li>\\n                                        <li>To notify progress for CRON call and re-trigger a call if there is remaining tasks, use <code>env['ir.cron']._notify_progress(done=task_done_count, remaining=task_remaining_count)</code></li>\\n                                    </ul>\\n                                    <p>\\n                                        <widget name=\\"documentation_link\\" path=\\"/developer/reference/backend/orm.html\\" label=\\"ORM API Documentation\\" icon=\\"oi oi-fw oi-arrow-right me-1\\"/>\\n                                    </p>\\n                                    <div>\\n                                        <p>Example of Python code:</p>\\n                                        <pre style=\\"white-space: pre-wrap\\">partner_name = record.name + '_code'\\nenv['res.partner'].create({'name': partner_name})\\n    </pre>\\n                                    </div>\\n                                </page>\\n                                <page string=\\"Usage\\" name=\\"usage\\" invisible=\\"1\\"/>\\n                            </notebook>\\n                        </t>\\n                    </sheet>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Server Action">\n                    <header invisible="context.get('is_modal')">\n                        <button name="create_action" string="Create Contextual Action" type="object" class="btn-primary" invisible="binding_model_id" help="Display an option in the 'More' top-menu in order to run this action."/>\n                        <button name="unlink_action" string="Remove Contextual Action" type="object" invisible="not binding_model_id" help="Remove 'More' top-menu contextual action related to this action"/>\n                        <button name="run" string="Run" type="object" class="btn-primary" invisible="model_name != 'ir.actions.server' or state != 'code'" help="Run this action manually."/>\n                        <button name="history_wizard_action" string="Code History" type="object" invisible="not show_code_history" help="View code history and restore a previous version"/>\n                    </header>\n                    <sheet>\n                        <div class="oe_button_box" name="button_box">\n                            <button type="object" name="action_open_parent_action" invisible="not parent_id" class="oe_stat_button" icon="fa-database">\n                                <div class="o_stat_info">\n                                    <span class="o_stat_text">Parent Action</span>\n                                </div>\n                            </button>\n                            <button type="object" name="action_open_scheduled_action" invisible="not ir_cron_ids or context.key != 'server_action'" context="{'key': 'ir_cron'}" class="oe_stat_button" icon="fa-refresh">\n                                <div class="o_stat_info">\n                                    <span class="o_stat_text">Scheduled Action</span>\n                                </div>\n                            </button>\n                        </div>\n                        <h1 class="oe_title">\n                            <field name="automated_name" invisible="1"/> <!-- needed for name compute -->\n                            <field name="name" placeholder="Set an explicit name"/>\n                        </h1>\n                        <group invisible="context.get('is_modal')">\n                            <group>\n                                <field name="model_id" options="{'no_create': True, 'no_open': True}" groups="base.group_no_one"/>\n                                <field name="model_id" options="{'no_create': True, 'no_open': True}" groups="!base.group_no_one" invisible="context.get('default_model_id')" domain="[('id', 'in', available_model_ids)]"/>\n                            </group>\n                            <group groups="base.group_no_one">\n                                <field name="group_ids" widget="many2many_tags"/>\n                            </group>\n                        </group>\n                        <t name="action_content" invisible="not model_id">\n                            <field name="allowed_states" invisible="1"/> <!-- Used to filter state using selection_badge_with_filter -->\n                            <div class="d-flex flex-column">\n                                <label for="state"/>\n                                <field name="state" widget="selection_badge_with_filter" options="{'size': 'sm', 'allowed_selection_field': 'allowed_states'}"/>\n                            </div>\n                            <div class="alert alert-warning" role="alert" invisible="not warning">\n                                <i class="fa fa-warning pe-2" title="Warning"/><field class="d-inline" name="warning" nolabel="1"/>\n                            </div>\n                            <div class="d-flex flex-row flex-wrap gap-2" invisible="state != 'object_write'">\n                                <field name="evaluation_type" class="oe_inline"/>\n                                <field name="update_path" widget="field_selector" class="oe_inline" options="{'model': 'model_name', 'allow_properties': False}" required="state == 'object_write'"/>\n                                <field name="update_field_id" invisible="True"/>  <!-- The field is store=True and readonly=False, in this view we want to save the value from compute/onchange -->\n                                <field name="update_related_model_id" invisible="True"/> <!-- This field is required for 'resource_ref' to compute possible m2m and m2o values -->\n                                <span invisible="evaluation_type != 'value' or update_field_type not in ['one2many', 'many2many']">by</span>\n                                <field name="update_m2m_operation" class="oe_inline" invisible="evaluation_type != 'value' or update_field_type not in ['one2many', 'many2many']" required="update_field_type in ['one2many', 'many2many']"/>\n                                <span invisible="evaluation_type != 'value' or update_field_type in ['one2many', 'many2many']">to</span>\n                                <span invisible="evaluation_type != 'sequence'">with</span>\n                                <field name="value" class="oe_inline" placeholder="Set a value..." invisible="update_field_id == False or value_field_to_show != 'value' or evaluation_type != 'value'" string="Custom Value"/>\n                                <field name="html_value" class="w-100" placeholder="Set a value..." invisible="update_field_id == False or value_field_to_show != 'html_value' or evaluation_type != 'value'" string="Custom Value"/>\n                                <field name="sequence_id" class="oe_inline" placeholder="Select a sequence..." invisible="evaluation_type != 'sequence'" required="evaluation_type == 'sequence'"/>\n                                <field name="resource_ref" class="oe_inline" placeholder="Choose a value..." string="Custom Value" options="{'model_field': 'update_related_model_id', 'no_create': True, 'no_open': True}" invisible="update_field_id == False or value_field_to_show != 'resource_ref' or evaluation_type == 'equation' or update_m2m_operation == 'clear'"/>\n                                <field name="selection_value" class="oe_inline" placeholder="Choose a value..." options="{'no_create': True, 'no_open': True}" invisible="update_field_id == False or value_field_to_show != 'selection_value' or evaluation_type == 'equation'"/>\n                                <field name="update_boolean_value" class="oe_inline" invisible="evaluation_type != 'value' or value_field_to_show != 'update_boolean_value'" required="value_field_to_show == 'update_boolean_value'"/>\n                                <span invisible="update_field_id != False or evaluation_type != 'value'" class="o_actions_server_set_a_value text-muted">Set a value...</span>\n                                <span invisible="evaluation_type != 'equation'">\n                                    to this Python expression:\n                                </span>\n                                <div class="w-100 d-flex flex-row gap-3" invisible="evaluation_type != 'equation'">\n                                    <field name="value" class="w-50" widget="code" options="{'mode': 'python'}" string="Expression"/>\n                                    <div class="w-50 opacity-75">\n                                        <span colspan="2" class="text-muted"> Available variables: </span>\n                                            <ul colspan="2" class="text-muted">\n                                                <li><code>env</code>: environment on which the action is triggered</li>\n                                                <li><code>model</code>: model of the record on which the action is triggered; is a void recordset</li>\n                                                <li><code>record</code>: record on which the action is triggered</li>\n                                                <li><code>records</code>: recordset of all records on which the action is triggered in multi mode</li>\n                                                <li><code>time</code>, <code>datetime</code>, <code>dateutil</code>, <code>timezone</code>: useful Python libraries</li>\n                                                <li><code>float_compare()</code>: utility function to compare floats based on a specific precision</li>\n                                            </ul>\n                                    </div>\n                                </div>\n                            </div>\n                            <group invisible="state not in ['object_create', 'object_copy']">\n                                <group>\n                                    <field name="crud_model_id" options="{'no_create': True, 'no_open': True}" required="state in ['object_create', 'object_copy']"/>\n                                    <field name="value" widget="char" string="Name" invisible="state != 'object_create'" help="The name of the record to create" placeholder="e.g. Follow-up"/>\n                                    <field name="resource_ref" placeholder="Choose a record..." string="Duplicate from" options="{'model_field': 'crud_model_id', 'no_create': True, 'no_open': True}" invisible="crud_model_id == False or state != 'object_copy'" required="state == 'object_copy'"/>\n                                    <field name="link_field_id" domain="[('model_id', '=', model_id), ('relation', '=', crud_model_name),                                         ('ttype', 'in', ['many2one', 'one2many', 'many2many'])]" placeholder="Select a field to link the record to" options="{'no_create': True, 'no_open': True}" context="{'default_model_id': model_id, 'default_relation': crud_model_name}"/>\n                                </group>\n                            </group>\n                            <group invisible="state != 'webhook'">\n                                <group>\n                                    <field name="webhook_url" string="URL" placeholder="e.g. https://maker.ifttt.com/use/..."/>\n                                    <field name="webhook_field_ids" string="Fields" widget="many2many_tags" context="{'hide_model': 1}" domain="[('model_id', '=', model_id)]" placeholder="Select fields to include in the request..."/>\n                                </group>\n                                <group>\n                                    <label for="webhook_sample_payload"/>\n                                    <field name="webhook_sample_payload" string="Sample Payload" nolabel="1" colspan="2" readonly="1" widget="code" options="{'mode': 'javascript'}"/>\n                                </group>\n                            </group>\n                            <t invisible="state != 'multi'">\n                                <field name="child_ids" widget="many2many" mode="kanban" context="{                                     'is_modal': 1,                                     'default_model_id': model_id,                                 }"/>\n                            </t>\n                            <notebook>\n                                <page string="Code" invisible="state != 'code'">\n                                    <field name="code" invisible="state != 'code'" widget="code" options="{'mode': 'python'}" placeholder="Enter Python code here. Help about Python expression is available in the help tab of this document."/>\n                                </page>\n                                <page string="Help" invisible="state != 'code'" name="ir_actions_server_code_help">\n                                    <p>The following variables can be used:</p>\n                                    <ul>\n                                        <li><code>env</code>: environment on which the action is triggered</li>\n                                        <li><code>model</code>: model of the record on which the action is triggered; is a void recordset</li>\n                                        <li><code>record</code>: record on which the action is triggered; may be be void</li>\n                                        <li><code>records</code>: recordset of all records on which the action is triggered in multi mode; may be void</li>\n                                        <li><code>time</code>, <code>datetime</code>, <code>dateutil</code>, <code>timezone</code>: useful Python libraries</li>\n                                        <li><code>float_compare()</code>: utility function to compare floats based on a specific precision</li>\n                                        <li><code>log(message, level='info')</code>: logging function to record debug information in <code>ir.logging</code> table</li>\n                                        <li><code>_logger.info(message)</code>: logger to emit messages in server logs</li>\n                                        <li><code>UserError</code>: exception class for raising user-facing warning messages</li>\n                                        <li><code>Command</code>: x2many commands namespace</li>\n                                        <li>To return an action, assign: <code>action = {...}</code></li>\n                                        <li>To notify progress for CRON call and re-trigger a call if there is remaining tasks, use <code>env['ir.cron']._notify_progress(done=task_done_count, remaining=task_remaining_count)</code></li>\n                                    </ul>\n                                    <p>\n                                        <widget name="documentation_link" path="/developer/reference/backend/orm.html" label="ORM API Documentation" icon="oi oi-fw oi-arrow-right me-1"/>\n                                    </p>\n                                    <div>\n                                        <p>Example of Python code:</p>\n                                        <pre style="white-space: pre-wrap">partner_name = record.name + '_code'\nenv['res.partner'].create({'name': partner_name})\n    </pre>\n                                    </div>\n                                </page>\n                                <page string="Usage" name="usage" invisible="1"/>\n                            </notebook>\n                        </t>\n                    </sheet>\n                </form>\n            	f	t	2026-09-09 14:26:16.143585	2026-09-09 14:26:16.143585
19	16	\N	1	1	Server Actions	ir.actions.server	\N	kanban	base/views/ir_actions_views.xml	primary	{"en_US": "<kanban>\\n                    <control>\\n                        <create string=\\"Add an action\\"/>\\n                    </control>\\n                    <field name=\\"state\\"/>\\n                    <field name=\\"evaluation_type\\"/>\\n                    <field name=\\"value\\"/>\\n                    <field name=\\"value_field_to_show\\"/>\\n                    <field name=\\"update_field_type\\"/>\\n                    <field name=\\"update_m2m_operation\\"/>\\n                    <templates>\\n                        <t t-name=\\"card\\" class=\\"o_draggable_norotate w-100 flex-row align-items-center gap-1\\">\\n                            <field name=\\"sequence\\" widget=\\"handle\\" class=\\"px-1\\"/>\\n                            <!-- Icon section -->\\n                            <i data-name=\\"server_action_icon\\" t-att-title=\\"record.state.value\\" class=\\"fa fa-fw\\" t-att-class=\\"{                                     'code': 'fa-code',                                     'object_create': 'fa-plus-square',                                     'object_copy': 'fa-clone',                                     'object_write': 'fa-pencil',                                     'multi': 'fa-list-ul',                                     'mail_post': 'fa-envelope',                                     'followers': 'fa-user',                                     'remove_followers': 'fa-user-times',                                     'next_activity': 'fa-clock-o',                                     'sms': 'fa-mobile',                                     'webhook': 'fa-paper-plane',                                     'whatsapp': 'fa-whatsapp',                                     'ai': 'fa-magic',                                 }[record.state.raw_value] || 'fa-circle-thin'\\"/>\\n                            <i class=\\"fa fa-warning text-warning px-2 m-0\\" invisible=\\"not warning\\" t-att-title=\\"record.warning.raw_value\\"/>\\n                            <field name=\\"name\\" class=\\"text-truncate\\"/>\\n                            <button type=\\"delete\\" name=\\"delete\\" class=\\"btn fa fa-trash fa-xl px-3 ms-auto\\" title=\\"Delete Action\\"/>\\n                        </t>\\n                    </templates>\\n                </kanban>"}	<?xml version="1.0"?>\n<kanban>\n                    <control>\n                        <create string="Add an action"/>\n                    </control>\n                    <field name="state"/>\n                    <field name="evaluation_type"/>\n                    <field name="value"/>\n                    <field name="value_field_to_show"/>\n                    <field name="update_field_type"/>\n                    <field name="update_m2m_operation"/>\n                    <templates>\n                        <t t-name="card" class="o_draggable_norotate w-100 flex-row align-items-center gap-1">\n                            <field name="sequence" widget="handle" class="px-1"/>\n                            <!-- Icon section -->\n                            <i data-name="server_action_icon" t-att-title="record.state.value" class="fa fa-fw" t-att-class="{                                     'code': 'fa-code',                                     'object_create': 'fa-plus-square',                                     'object_copy': 'fa-clone',                                     'object_write': 'fa-pencil',                                     'multi': 'fa-list-ul',                                     'mail_post': 'fa-envelope',                                     'followers': 'fa-user',                                     'remove_followers': 'fa-user-times',                                     'next_activity': 'fa-clock-o',                                     'sms': 'fa-mobile',                                     'webhook': 'fa-paper-plane',                                     'whatsapp': 'fa-whatsapp',                                     'ai': 'fa-magic',                                 }[record.state.raw_value] || 'fa-circle-thin'"/>\n                            <i class="fa fa-warning text-warning px-2 m-0" invisible="not warning" t-att-title="record.warning.raw_value"/>\n                            <field name="name" class="text-truncate"/>\n                            <button type="delete" name="delete" class="btn fa fa-trash fa-xl px-3 ms-auto" title="Delete Action"/>\n                        </t>\n                    </templates>\n                </kanban>\n            	f	t	2026-09-09 14:26:16.143585	2026-09-09 14:26:16.143585
