dio\\"/>\\n                            </group>\\n                            <group>\\n                                <div class=\\"text-muted fst-italic\\" role=\\"alert\\" colspan=\\"2\\" invisible=\\"not smtp_authentication_info\\">\\n                                    <field name=\\"smtp_authentication_info\\"/>\\n                                </div>\\n                            </group>\\n                        </group>\\n                        <notebook colspan=\\"4\\" invisible=\\"smtp_authentication == 'cli'\\">\\n                            <page name=\\"connection\\" string=\\"Connection\\">\\n                                <group>\\n                                    <group>\\n                                        <field name=\\"smtp_encryption\\" widget=\\"radio\\"/>\\n                                        <field name=\\"smtp_debug\\" groups=\\"base.group_no_one\\"/>\\n                                        <field name=\\"smtp_host\\" required=\\"smtp_authentication != 'cli'\\"/>\\n                                        <field name=\\"smtp_port\\" options=\\"{'enable_formatting': false}\\" required=\\"smtp_authentication != 'cli'\\"/>\\n                                    </group>\\n                                    <group>\\n                                        <label for=\\"smtp_user\\" string=\\"Username\\" invisible=\\"smtp_authentication == 'certificate'\\"/>\\n                                        <field name=\\"smtp_user\\" invisible=\\"smtp_authentication == 'certificate'\\" force_save=\\"1\\" nolabel=\\"1\\"/>\\n                                        <field name=\\"smtp_pass\\" invisible=\\"smtp_authentication != 'login'\\" password=\\"True\\" force_save=\\"1\\"/>\\n                                        <field name=\\"smtp_ssl_certificate\\" invisible=\\"smtp_authentication != 'certificate'\\" force_save=\\"1\\"/>\\n                                        <field name=\\"smtp_ssl_private_key\\" invisible=\\"smtp_authentication != 'certificate'\\" force_save=\\"1\\"/>\\n                                    </group>\\n                                </group>\\n                            </page>\\n                        </notebook>\\n                    </sheet>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Outgoing Mail Servers">\n                    <header>\n                        <button string="Test Connection" type="object" name="test_smtp_connection" class="btn-primary"/>\n                    </header>\n                    <sheet>\n                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>\n                        <group>\n                            <group>\n                                <field name="name" placeholder="e.g. My Outgoing Server"/>\n                                <field name="from_filter" placeholder="e.g. email@domain.com, domain.com"/>\n                            </group>\n                            <group>\n                                <field name="sequence"/>\n                                <div colspan="2" class="d-flex justify-content-between">\n                                    <div>\n                                        <label for="max_email_size" string="Convert attachments to links for emails over"/>\n                                        <field name="max_email_size" class="oe_inline mx-1"/>\n                                        <span class="o_form_label">MB</span>\n                                    </div>\n                                    <button class="btn btn-link pt-0" type="object" name="action_retrieve_max_email_size">\n                                        <i class="fa fa-gear"/> Detect Max Limit\n                                    </button>\n                                </div>\n                            </group>\n                        </group>\n                        <group>\n                            <group>\n                        