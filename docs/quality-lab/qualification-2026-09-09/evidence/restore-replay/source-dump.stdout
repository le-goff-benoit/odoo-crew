t>\\n                        <t t-if=\\"has_state\\">\\n                            <span itemprop=\\"addressRegion\\" t-out=\\"object.state_id.code\\"/>,\\n                        </t>\\n                        <span itemprop=\\"addressCountry\\" t-out=\\"country_id\\"/>\\n                    </div>\\n                </span>\\n            </div>\\n            <div class=\\"d-flex align-items-center gap-1\\" t-if=\\"phone and 'phone' in fields\\">\\n                <i t-if=\\"not options.get('no_marker') or options.get('phone_icons')\\" class=\\"fa fa-phone fa-fw\\" role=\\"img\\" aria-label=\\"Phone\\" title=\\"Phone\\"/> <span class=\\"o_force_ltr\\" itemprop=\\"telephone\\" t-esc=\\"phone\\"/>\\n            </div>\\n            <div class=\\"d-flex align-items-center gap-1\\" t-if=\\"mobile and 'mobile' in fields\\">\\n                <i t-if=\\"not options.get('no_marker') or options.get('phone_icons')\\" class=\\"fa fa-mobile fa-fw\\" role=\\"img\\" aria-label=\\"Mobile\\" title=\\"Mobile\\"/> <span class=\\"o_force_ltr\\" itemprop=\\"telephone\\" t-esc=\\"mobile\\"/>\\n            </div>\\n            <!-- Prevent issue with iOS Safari parsing of schema data without telephone itemprops -->\\n            <div t-if=\\"not (phone and 'phone' in fields) and not (mobile and 'mobile' in fields)\\" itemprop=\\"telephone\\"/>\\n            <div class=\\"d-flex align-items-baseline gap-1\\" t-if=\\"website and 'website' in fields\\">\\n                <i t-if=\\"not options.get('no_marker')\\" class=\\"fa fa-globe fa-fw\\" role=\\"img\\" aria-label=\\"Website\\" title=\\"Website\\"/>\\n                <a class=\\"text-break w-100\\" t-att-href=\\"website and '%s%s' % ('http://' if '://' not in website else '',website)\\"><span itemprop=\\"website\\" t-esc=\\"website\\"/></a>\\n            </div>\\n            <div class=\\"d-flex align-items-baseline gap-1\\" t-if=\\"email and 'email' in fields\\"><i t-if=\\"not options.get('no_marker')\\" class=\\"fa fa-envelope fa-fw\\" role=\\"img\\" aria-label=\\"Email\\" title=\\"Email\\"/> <span class=\\"text-break w-100\\" itemprop=\\"email\\" t-esc=\\"email\\"/></div>\\n        </div>\\n        <div t-if=\\"vat and 'vat' in fields\\"><span t-esc=\\"vat_label\\"/>: <span itemprop=\\"vatID\\" t-esc=\\"vat\\"/></div>\\n        <t t-if=\\"object.country_id and object.country_id.name_position == 'after'\\">\\n            <t t-call=\\"base.contact_name\\"/>\\n        </t>\\n    </address>\\n</t>"}	<?xml version="1.0"?>\n<t t-name="base.contact">\n    <address t-ignore="true" class="o_portal_address mb-0">\n        <div t-if="not (('name' in fields) or (address and 'address' in fields) or (city and 'city' in fields) or (mobile and 'mobile' in fields) or (website and 'website' in fields) or (email and 'email' in fields))" class="css_non_editable_mode_hidden">\n            --<span class="text-muted" t-esc="name"/>--\n        </div>\n        <t t-if="object.country_id.name_position != 'after'">\n            <t t-call="base.contact_name"/>\n        </t>\n        <div class="gap-2" t-att-itemprop="options.get('with_microdata') and 'address'" itemscope="itemscope" itemtype="http://schema.org/PostalAddress">\n\n            <div t-if="address and 'address' in fields" t-attf-class="d-flex align-items-baseline gap-1">\n                <i t-if="not options.get('no_marker')" class="fa fa-map-marker fa-fw" role="img" aria-label="Address" title="Address"/>\n                <span class="w-100 lh-sm text-break d-block" itemprop="streetAddress" t-esc="address"/>\n            </div>\n            <t t-set="has_city" t-value="city and 'city' in fields"/>\n            <t t-set="has_state" t-value="object.state_id and object.country_id.state_required"/>\n            <div t-if="has_city or (country_id and 'country_id' in fields)" t-attf-class="d-flex align-items-baseline gap-1">\n                <i t-if="not options.get('no_marker')" class="fa fa-map-marker fa-fw" role="img" aria-label="Address" title="Address"/>\n                <span>\n                    <div>\n                        <t t-if="has_city">\n                            <span itemprop="addressLocality" t-out="city"/><t t-if="country_id">,</t>\n                        </t>\n                        <t t-if="has_state">\n                            <span itemprop="addressRegion" t-out="object.state_id.code"/>,\n                        </t>\n                        <span itemprop="addressCountry" t-out="country_id"/>\n                    </div>\n                </span>\n            </div>\n            <div class="d-flex align-items-center gap-1" t-if="phone and 'phone' in fields">\n                <i t-if="not options.get('no_marker') or options.get('phone_icons')" class="fa fa-phone fa-fw" role="img" aria-label="Phone" title="Phone"/> <span class="o_force_ltr" itemprop="telephone" t-esc="phone"/>\n            </div>\n            <div class="d-flex align-items-center gap-1" t-if="mobile and 'mobile' in fields">\n                <i t-if="not options.get('no_marker') or options.get('phone_icons')" class="fa fa-mobile fa-fw" role="img" aria-label="Mobile" title="Mobile"/> <span class="o_force_ltr" itemprop="telephone" t-esc="mobile"/>\n            </div>\n            <!-- Prevent issue with iOS Safari parsing of schema data without telephone itemprops -->\n            <div t-if="not (phone and 'phone' in fields) and not (mobile and 'mobile' in fields)" itemprop="telephone"/>\n            <div class="d-flex align-items-baseline gap-1" t-if="website and 'website' in fields">\n                <i t-if="not options.get('no_marker')" class="fa fa-globe fa-fw" role="img" aria-label="Website" title="Website"/>\n                <a class="text-break w-100" t-att-href="website and '%s%s' % ('http://' if '://' not in website else '',website)"><span itemprop="website" t-esc="website"/></a>\n            </div>\n            <div class="d-flex align-items-baseline gap-1" t-if="email and 'email' in fields"><i t-if="not options.get('no_marker')" class="fa fa-envelope fa-fw" role="img" aria-label="Email" title="Email"/> <span class="text-break w-100" itemprop="email" t-esc="email"/></div>\n        </div>\n        <div t-if="vat and 'vat' in fields"><span t-esc="vat_label"/>: <span itemprop="vatID" t-esc="vat"/></div>\n        <t t-if="object.country_id and object.country_id.name_position == 'after'">\n            <t t-call="base.contact_name"/>\n        </t>\n    </address>\n</t>\n\n	f	t	2026-09-09 14:26:16.143585	2026-09-09 14:26:16.143585
