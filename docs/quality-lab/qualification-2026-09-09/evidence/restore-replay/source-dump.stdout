127	1	\N	1	1	res.partner.form	res.partner	\N	form	base/views/res_partner_views.xml	primary	{"en_US": "<form string=\\"Partners\\">\\n                <div class=\\"alert alert-warning oe_edit_only\\" role=\\"alert\\" name=\\"warning_tax\\" invisible=\\"not same_vat_partner_id and not same_company_registry_partner_id\\">\\n                    Potential duplicates:\\n                    <span invisible=\\"not same_vat_partner_id or same_company_registry_partner_id\\">\\n                        <field name=\\"same_vat_partner_id\\" context=\\"{'show_address': False, 'show_vat': False}\\"/>\\n                        (Same <field name=\\"vat_label\\"/>)\\n                    </span>\\n                    <span invisible=\\"same_vat_partner_id or not same_company_registry_partner_id\\">\\n                        <field name=\\"same_company_registry_partner_id\\" context=\\"{'show_address': False, 'show_vat': False}\\"/>\\n                        (Same <field name=\\"company_registry_label\\"/>)\\n                    </span>\\n                    <span invisible=\\"not (same_vat_partner_id and same_company_registry_partner_id and same_vat_partner_id == same_company_registry_partner_id)\\">\\n                        <field name=\\"same_vat_partner_id\\" context=\\"{'show_address': False, 'show_vat': False}\\"/>\\n                        (Same <field name=\\"vat_label\\"/> and <field name=\\"company_registry_label\\"/>)\\n                    </span>\\n                    <span invisible=\\"not (same_vat_partner_id and same_company_registry_partner_id and same_vat_partner_id != same_company_registry_partner_id)\\">\\n                        <field name=\\"same_vat_partner_id\\" context=\\"{'show_address': False, 'show_vat': False}\\"/>\\n                        (Same <field name=\\"vat_label\\"/>) and\\n                        <field name=\\"same_company_registry_partner_id\\" context=\\"{'show_address': False, 'show_vat': False}\\"/>\\n                        (Same <field name=\\"company_registry_label\\"/>)\\n                    </span>\\n                </div>\\n                <sheet>\\n                    <div class=\\"oe_button_box\\" name=\\"button_box\\"/>\\n                    <widget name=\\"web_ribbon\\" title=\\"Archived\\" bg_color=\\"text-bg-danger\\" invisible=\\"active\\"/>\\n                    <div class=\\"mb8\\">\\n                        <div class=\\"d-flex gap-3\\">\\n                            <field name=\\"image_1920\\" widget=\\"contact_image\\" options=\\"{'preview_image': 'avatar_128', 'size': [130,130], 'img_class': 'rounded border'}\\"/>\\n                            <field name=\\"avatar_128\\" invisible=\\"1\\"/> <!-- Needed in contact_image widget -->\\n                            <div class=\\"d-flex flex-column flex-grow-1\\">\\n                                <field name=\\"company_type\\" widget=\\"radio\\" options=\\"{'horizontal': true}\\"/>\\n                                <h1 class=\\"mb-0 w-md-75\\">\\n                                    <field options=\\"{'line_breaks': False}\\" widget=\\"text\\" class=\\"text-break d-block\\" name=\\"name\\" default_focus=\\"1\\" placeholder=\\"e.g. Lumber Inc\\" invisible=\\"not is_company\\" required=\\"type == 'contact'\\"/>\\n                                    <field options=\\"{'line_breaks': False}\\" widget=\\"text\\" class=\\"text-break d-block\\" name=\\"name\\" default_focus=\\"1\\" placeholder=\\"e.g. Brandon Freeman\\" invisible=\\"is_company\\" required=\\"type == 'contact'\\"/>\\n                                </h1>\\n                                <div class=\\"d-flex align-items-baseline w-md-50\\">\\n                                    <i class=\\"fa fa-fw me-1 fa-envelope text-primary\\" title=\\"Email\\"/>\\n                                    <field name=\\"email\\" class=\\"w-100\\" widget=\\"email\\" required=\\"user_ids\\" placeholder=\\"Email\\"/>\\n                                </div>\\n                                <div class=\\"d-flex align-items-baseline w-md-50\\">\\n                                    <i class=\\"fa fa-fw me-1 fa-phone text-primary\\" title=\\"Phone\\"/>\\n                                    <field name=\\"phone\\" class=\\"w-100\\" widget=\\"phone\\" placeholder=\\"Phone\\"/>\\n                                </div>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <group>\\n                        <group>\\n                            <field name=\\"parent_id\\" widget=\\"res_partner_many2one\\" placeholder=\\"Company Name...\\" string=\\"Company\\" domain=\\"[('is_company', '=', True)]\\" context=\\"{'default_is_company': True, 'default_user_id': user_id, 'show_address': False}\\" invisible=\\"((is_company and not parent_id) or company_name) and company_name != ''\\"/>\\n                            <div colspan=\\"2\\" class=\\"d-flex gap-2\\" invisible=\\"not company_name or company_name == '' or is_company\\">\\n                                <label for=\\"company_name\\" class=\\"fw-bold text-nowrap\\"/>\\n                                <field name=\\"company_name\\"/>\\n                                <button name=\\"create_company\\" icon=\\"fa-plus-square\\" string=\\"Create\\" type=\\"object\\" class=\\"oe_edit_only btn-link text-nowrap\\"/>\\n                            </div>\\n                            <span class=\\"o_form_label o_td_label o_address_type\\" name=\\"address_name\\">\\n                                <field name=\\"type_address_label\\" invisible=\\"is_company\\" readonly=\\"1\\" class=\\"fw-bold\\"/>\\n                                <span invisible=\\"not is_company\\">Address</span>\\n                            </span>\\n                            <div class=\\"o_address_format\\">\\n                                <field name=\\"street\\" placeholder=\\"Street...\\" class=\\"o_address_street\\"/>\\n                                <field name=\\"street2\\" placeholder=\\"Street 2...\\" class=\\"o_address_street\\"/>\\n                                <field name=\\"city\\" placeholder=\\"City\\" class=\\"o_address_city\\"/>\\n                                <field name=\\"state_id\\" placeholder=\\"State\\" class=\\"o_address_state\\" options=\\"{'no_open': True, 'no_quick_create': True}\\" context=\\"{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}\\"/>\\n                                <field name=\\"zip\\" placeholder=\\"ZIP\\" class=\\"o_address_zip\\"/>\\n                                <div name=\\"partner_address_country\\" class=\\"d-flex justify-content-between\\">\\n                                    <field name=\\"country_id\\" placeholder=\\"Country\\" class=\\"o_address_country\\" options=\\"{&quot;no_open&quot;: True, &quot;no_create&quot;: True}\\"/>\\n                                </div>\\n                            </div>\\n                        </group>\\n                        <group>\\n                            <field name=\\"function\\" placeholder=\\"e.g. Sales Director\\" invisible=\\"is_company\\"/>\\n                            <field name=\\"vat\\" placeholder=\\"e.g. BE0477472701\\"/>\\n                            <field name=\\"website\\" string=\\"Website\\" widget=\\"url\\" placeholder=\\"e.g. https://www.odoo.com\\"/>\\n                            <field name=\\"lang\\" invisible=\\"active_lang_count &lt;= 1\\"/>\\n                            <field name=\\"category_id\\" widget=\\"many2many_tags\\" options=\\"{'color_field': 'color'}\\" placeholder=\\"e.g. &quot;B2B&quot;, &quot;VIP&quot;, &quot;Consulting&quot;, ...\\"/>\\n                        </group>\\n                    </group>\\n                    <div class=\\"d-flex\\">\\n                        <field name=\\"properties\\" nolabel=\\"1\\" columns=\\"2\\"/>\\n                    </div>\\n\\n                    <notebook colspan=\\"4\\">\\n                        <page string=\\"Contacts\\" name=\\"contact_addresses\\" autofocus=\\"autofocus\\">\\n                            <field name=\\"child_ids\\" mode=\\"kanban\\" context=\\"{'default_parent_id': id, 'default_street': street, 'default_street2': street2, 'default_city': city, 'default_state_id': state_id, 'default_zip': zip, 'default_country_id': country_id, 'default_lang': lang, 'default_user_id': user_id, 'default_type': is_company and 'contact' or 'other'}\\">\\n                                <kanban color=\\"color\\">\\n                                    <field name=\\"color\\"/>\\n                                    <field name=\\"type\\"/>\\n                                    <field name=\\"is_company\\"/>\\n                                    <templates>\\n                                        <t t-name=\\"card\\" class=\\"flex-row\\">\\n                                            <aside class=\\"o_kanban_aside_full\\">\\n                                                <field name=\\"avatar_128\\" class=\\"o_kanban_image_fill w-100\\" widget=\\"image\\" options=\\"{'img_class': 'object-fit-cover'}\\" alt=\\"Contact image\\" invisible=\\"type != 'contact'\\"/>\\n                                                <field name=\\"avatar_128\\" class=\\"o_kanban_image_fill w-100\\" widget=\\"image\\" options=\\"{'img_class': 'object-fit-contain p-2'}\\" alt=\\"Contact image\\" invisible=\\"type == 'contact'\\"/>\\n                                            </aside>\\n                                            <main class=\\"ps-2 ps-md-0\\">\\n                                                <field name=\\"name\\" invisible=\\"not name\\" class=\\"fw-bold\\"/>\\n                                                <field name=\\"type\\" invisible=\\"name\\" class=\\"fw-bold\\"/>\\n                                                <div t-if=\\"record.email.raw_value\\" class=\\"text-truncate\\">\\n                                                    <i class=\\"fa fa-fw me-1 fa-envelope text-primary\\" title=\\"Email\\"/>\\n                                                    <field name=\\"email\\"/>\\n                                                </div>\\n                                                <div t-if=\\"record.phone.raw_value\\">\\n                                                    <i class=\\"fa fa-fw me-1 fa-phone text-primary\\" title=\\"Phone\\"/>\\n                                                    <field name=\\"phone\\"/>\\n                                                </div>\\n                                                <div invisible=\\"not function or is_company\\">\\n                                                    <i class=\\"fa fa-fw me-1 fa-suitcase text-primary\\" title=\\"Position\\"/>\\n                                                    <field name=\\"function\\"/>\\n                                                </div>\\n                                                <div t-if=\\"record.type.raw_value != 'contact' and (record.city.raw_value or record.country_id.raw_value)\\">\\n                                                    <i class=\\"fa fa-fw me-1 fa-map-marker text-primary\\" title=\\"Location\\"/>\\n                                                    <field name=\\"city\\"/>\\n                                                    <span t-if=\\"record.city.raw_value and record.country_id.raw_value\\">, </span>\\n                                                    <field name=\\"country_id\\"/>\\n                                                </div>\\n                                            </main>\\n                                        </t>\\n                                    </templates>\\n                                </kanban>\\n                                <form string=\\"Contact / Address\\">\\n                                    <sheet>\\n                                        <field name=\\"type\\" required=\\"1\\" widget=\\"radio\\" options=\\"{'horizontal': true}\\"/>\\n                                        <div class=\\"d-flex align-items-center gap-3\\">\\n                                            <field name=\\"image_1920\\" widget=\\"contact_image\\" nolabel=\\"1\\" options=\\"{'preview_image': 'avatar_128', 'size': [100,100], 'img_class': 'rounded border'}\\"/>\\n                                            <div class=\\"flex-grow-1\\">\\n                                                <h3>\\n                                                    <field name=\\"name\\" class=\\"d-block\\" string=\\"Name\\" default_focus=\\"1\\" required=\\"type == 'contact'\\" placeholder=\\"e.g. Brandon Freeman\\"/>\\n                                                </h3>\\n                                                <div class=\\"row flex-row\\">\\n                                                    <div class=\\"d-flex align-items-baseline\\">\\n                                                        <i class=\\"fa fa-fw me-1 fa-envelope text-primary\\" title=\\"Email\\"/>\\n                                                        <field name=\\"email\\" widget=\\"email\\" class=\\"w-100\\" context=\\"{'gravatar_image': True}\\" required=\\"user_ids\\" placeholder=\\"Email\\"/>\\n                                                    </div>\\n                                                    <div class=\\"d-flex align-items-baseline\\">\\n                                                        <i class=\\"fa fa-fw me-1 fa-phone text-primary\\" title=\\"Phone\\"/>\\n                                                        <field name=\\"phone\\" widget=\\"phone\\" class=\\"w-100\\" placeholder=\\"Phone\\"/>\\n                                                    </div>\\n                                                    <div invisible=\\"is_company or type != 'contact'\\" class=\\"d-flex align-items-baseline\\">\\n                                                        <i class=\\"fa fa-fw me-1 fa-suitcase text-primary\\" title=\\"Position\\"/>\\n                                                        <field name=\\"function\\" placeholder=\\"Job title\\"/>\\n                                                    </div>\\n                                                </div>\\n                                            </div>\\n                                        </div>\\n                                        <group invisible=\\"type == 'contact'\\" name=\\"other_info\\">\\n                                            <group>\\n                                                <span class=\\"o_form_label o_td_label o_address_type\\">\\n                                                    <field name=\\"type_address_label\\" readonly=\\"1\\" class=\\"fw-bold\\"/>\\n                                                </span>\\n                                                <div class=\\"o_address_format\\" name=\\"div_address\\">\\n                                                    <field name=\\"street\\" placeholder=\\"Street...\\" class=\\"o_address_street\\"/>\\n                                                    <field name=\\"street2\\" placeholder=\\"Street 2...\\" class=\\"o_address_street\\"/>\\n                                                    <field name=\\"city\\" placeholder=\\"City\\" class=\\"o_address_city\\"/>\\n                                                    <field name=\\"state_id\\" class=\\"o_address_state\\" placeholder=\\"State\\" options=\\"{'no_open': True, 'no_quick_create': True}\\" context=\\"{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}\\"/>\\n                                                    <field name=\\"zip\\" placeholder=\\"ZIP\\" class=\\"o_address_zip\\"/>\\n                                                    <field name=\\"country_id\\" placeholder=\\"Country\\" class=\\"o_address_country\\" options=\\"{&quot;no_open&quot;: True, &quot;no_create&quot;: True}\\"/>\\n                                                </div>\\n                                            </group>\\n                                        </group>\\n                                        <group>\\n                                            <field name=\\"company_id\\" invisible=\\"1\\"/>    <!-- Need to save value from parented record, cf onchange -->\\n                                            <label for=\\"comment\\"/>\\n                                            <field name=\\"comment\\" options=\\"{'height': 100}\\" placeholder=\\"Internal notes...\\" nolabel=\\"1\\"/>\\n                                        </group>\\n                                        <field name=\\"lang\\" invisible=\\"True\\"/>  <!-- Need to add lang to save default value from parented record -->\\n                                    </sheet>\\n                                </form>\\n                            </field>\\n                        </page>\\n                        <page name=\\"sales_purchases\\" string=\\"Sales &amp; Purchase\\">\\n                            <group name=\\"container_row_2\\">\\n                                <group string=\\"Sales\\" name=\\"sale\\" priority=\\"1\\">\\n                                    <field name=\\"user_id\\" widget=\\"many2one_avatar_user\\" domain=\\"[('share', '=', False)]\\"/>\\n                                </group>\\n                                <group string=\\"Purchase\\" name=\\"purchase\\" priority=\\"2\\">\\n                                </group>\\n                                <group name=\\"misc\\" string=\\"Misc\\">\\n                                    <field name=\\"company_registry_placeholder\\" invisible=\\"1\\"/> <!-- Needed for the placeholder widget -->\\n                                    <field name=\\"company_registry\\" invisible=\\"parent_id or not is_company\\" options=\\"{'placeholder_field': 'company_registry_placeholder'}\\"/>\\n                                    <field name=\\"ref\\" string=\\"Reference\\"/>\\n                                    <field name=\\"company_id\\" groups=\\"base.group_multi_company\\" options=\\"{'no_create': True}\\" readonly=\\"parent_id\\" force_save=\\"1\\" placeholder=\\"Visible to all\\"/>\\n                                    <field name=\\"company_id\\" invisible=\\"1\\"/> <!-- need to be able to compute based on the company even without multi company groups -->\\n                                    <field name=\\"industry_id\\" invisible=\\"not is_company\\" options=\\"{'no_create': True}\\"/>\\n                                </group>\\n                            </group>\\n                        </page>\\n                        <page name=\\"internal_notes\\" string=\\"Notes\\">\\n                            <field name=\\"comment\\" placeholder=\\"Internal notes...\\"/>\\n                            <group name=\\"warnings\\"/>\\n                        </page>\\n                    </notebook>\\n                </sheet>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Partners">\n                <div class="alert alert-warning oe_edit_only" role="alert" name="warning_tax" invisible="not same_vat_partner_id and not same_company_registry_partner_id">\n                    Potential duplicates:\n                    <span invisible="not same_vat_partner_id or same_company_registry_partner_id">\n                        <field name="same_vat_partner_id" context="{'show_address': False, 'show_vat': False}"/>\n                        (Same <field name="vat_label"/>)\n                    </span>\n                    <span invisible="same_vat_partner_id or not same_company_registry_partner_id">\n                        <field name="same_company_registry_partner_id" context="{'show_address': False, 'show_vat': False}"/>\n                        (Same <field name="company_registry_label"/>)\n                    </span>\n                    <span invisible="not (same_vat_partner_id and same_company_registry_partner_id and same_vat_partner_id == same_company_registry_partner_id)">\n                        <field name="same_vat_partner_id" context="{'show_address': False, 'show_vat': False}"/>\n                        (Same <field name="vat_label"/> and <field name="company_registry_label"/>)\n                    </span>\n                    <span invisible="not (same_vat_partner_id and same_company_registry_partner_id and same_vat_partner_id != same_company_registry_partner_id)">\n                        <field name="same_vat_partner_id" context="{'show_address': False, 'show_vat': False}"/>\n                        (Same <field name="vat_label"/>) and\n                        <field name="same_company_registry_partner_id" context="{'show_address': False, 'show_vat': False}"/>\n                        (Same <field name="company_registry_label"/>)\n                    </span>\n                </div>\n                <sheet>\n                    <div class="oe_button_box" name="button_box"/>\n                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>\n                    <div class="mb8">\n                        <div class="d-flex gap-3">\n                            <field name="image_1920" widget="contact_image" options="{'preview_image': 'avatar_128', 'size': [130,130], 'img_class': 'rounded border'}"/>\n                            <field name="avatar_128" invisible="1"/> <!-- Needed in contact_image widget -->\n                            <div class="d-flex flex-column flex-grow-1">\n                                <field name="company_type" widget="radio" options="{'horizontal': true}"/>\n                                <h1 class="mb-0 w-md-75">\n                                    <field options="{'line_breaks': False}" widget="text" class="text-break d-block" name="name" default_focus="1" placeholder="e.g. Lumber Inc" invisible="not is_company" required="type == 'contact'"/>\n                                    <field options="{'line_breaks': False}" widget="text" class="text-break d-block" name="name" default_focus="1" placeholder="e.g. Brandon Freeman" invisible="is_company" required="type == 'contact'"/>\n                                </h1>\n                                <div class="d-flex align-items-baseline w-md-50">\n                                    <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>\n                                    <field name="email" class="w-100" widget="email" required="user_ids" placeholder="Email"/>\n                                </div>\n                                <div class="d-flex align-items-baseline w-md-50">\n                                    <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>\n                                    <field name="phone" class="w-100" widget="phone" placeholder="Phone"/>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <group>\n                        <group>\n                            <field name="parent_id" widget="res_partner_many2one" placeholder="Company Name..." string="Company" domain="[('is_company', '=', True)]" context="{'default_is_company': True, 'default_user_id': user_id, 'show_address': False}" invisible="((is_company and not parent_id) or company_name) and company_name != ''"/>\n                            <div colspan="2" class="d-flex gap-2" invisible="not company_name or company_name == '' or is_company">\n                                <label for="company_name" class="fw-bold text-nowrap"/>\n                                <field name="company_name"/>\n                                <button name="create_company" icon="fa-plus-square" string="Create" type="object" class="oe_edit_only btn-link text-nowrap"/>\n                            </div>\n                            <span class="o_form_label o_td_label o_address_type" name="address_name">\n                                <field name="type_address_label" invisible="is_company" readonly="1" class="fw-bold"/>\n                                <span invisible="not is_company">Address</span>\n                            </span>\n                            <div class="o_address_format">\n                                <field name="street" placeholder="Street..." class="o_address_street"/>\n                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>\n                                <field name="city" placeholder="City" class="o_address_city"/>\n                                <field name="state_id" placeholder="State" class="o_address_state" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>\n                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>\n                                <div name="partner_address_country" class="d-flex justify-content-between">\n                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>\n                                </div>\n                            </div>\n                        </group>\n                        <group>\n                            <field name="function" placeholder="e.g. Sales Director" invisible="is_company"/>\n                            <field name="vat" placeholder="e.g. BE0477472701"/>\n                            <field name="website" string="Website" widget="url" placeholder="e.g. https://www.odoo.com"/>\n                            <field name="lang" invisible="active_lang_count &lt;= 1"/>\n                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color'}" placeholder="e.g. &quot;B2B&quot;, &quot;VIP&quot;, &quot;Consulting&quot;, ..."/>\n                        </group>\n                    </group>\n                    <div class="d-flex">\n                        <field name="properties" nolabel="1" columns="2"/>\n                    </div>\n\n                    <notebook colspan="4">\n                        <page string="Contacts" name="contact_addresses" autofocus="autofocus">\n                            <field name="child_ids" mode="kanban" context="{'default_parent_id': id, 'default_street': street, 'default_street2': street2, 'default_city': city, 'default_state_id': state_id, 'default_zip': zip, 'default_country_id': country_id, 'default_lang': lang, 'default_user_id': user_id, 'default_type': is_company and 'contact' or 'other'}">\n                                <kanban color="color">\n                                    <field name="color"/>\n                                    <field name="type"/>\n                                    <field name="is_company"/>\n                                    <templates>\n                                        <t t-name="card" class="flex-row">\n                                            <aside class="o_kanban_aside_full">\n                                                <field name="avatar_128" class="o_kanban_image_fill w-100" widget="image" options="{'img_class': 'object-fit-cover'}" alt="Contact image" invisible="type != 'contact'"/>\n                                                <field name="avatar_128" class="o_kanban_image_fill w-100" widget="image" options="{'img_class': 'object-fit-contain p-2'}" alt="Contact image" invisible="type == 'contact'"/>\n                                            </aside>\n                                            <main class="ps-2 ps-md-0">\n                                                <field name="name" invisible="not name" class="fw-bold"/>\n                                                <field name="type" invisible="name" class="fw-bold"/>\n                                                <div t-if="record.email.raw_value" class="text-truncate">\n                                                    <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>\n                                                    <field name="email"/>\n                                                </div>\n                                                <div t-if="record.phone.raw_value">\n                                                    <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>\n                                                    <field name="phone"/>\n                                                </div>\n                                                <div invisible="not function or is_company">\n                                                    <i class="fa fa-fw me-1 fa-suitcase text-primary" title="Position"/>\n                                                    <field name="function"/>\n                                                </div>\n                                                <div t-if="record.type.raw_value != 'contact' and (record.city.raw_value or record.country_id.raw_value)">\n                                                    <i class="fa fa-fw me-1 fa-map-marker text-primary" title="Location"/>\n                                                    <field name="city"/>\n                                                    <span t-if="record.city.raw_value and record.country_id.raw_value">, </span>\n                                                    <field name="country_id"/>\n                                                </div>\n                                            </main>\n                                        </t>\n                                    </templates>\n                                </kanban>\n                                <form string="Contact / Address">\n                                    <sheet>\n                                        <field name="type" required="1" widget="radio" options="{'horizontal': true}"/>\n                                        <div class="d-flex align-items-center gap-3">\n                                            <field name="image_1920" widget="contact_image" nolabel="1" options="{'preview_image': 'avatar_128', 'size': [100,100], 'img_class': 'rounded border'}"/>\n                                            <div class="flex-grow-1">\n                                                <h3>\n                                                    <field name="name" class="d-block" string="Name" default_focus="1" required="type == 'contact'" placeholder="e.g. Brandon Freeman"/>\n                                                </h3>\n                                                <div class="row flex-row">\n                                                    <div class="d-flex align-items-baseline">\n                                                        <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>\n                                                        <field name="email" widget="email" class="w-100" context="{'gravatar_image': True}" required="user_ids" placeholder="Email"/>\n                                                    </div>\n                                                    <div class="d-flex align-items-baseline">\n                                                        <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>\n                                                        <field name="phone" widget="phone" class="w-100" placeholder="Phone"/>\n                                                    </div>\n                                                    <div invisible="is_company or type != 'contact'" class="d-flex align-items-baseline">\n                                                        <i class="fa fa-fw me-1 fa-suitcase text-primary" title="Position"/>\n                                                        <field name="function" placeholder="Job title"/>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                        <group invisible="type == 'contact'" name="other_info">\n                                            <group>\n                                                <span class="o_form_label o_td_label o_address_type">\n                                                    <field name="type_address_label" readonly="1" class="fw-bold"/>\n                                                </span>\n                                                <div class="o_address_format" name="div_address">\n                                                    <field name="street" placeholder="Street..." class="o_address_street"/>\n                                                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>\n                                                    <field name="city" placeholder="City" class="o_address_city"/>\n                                                    <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>\n                                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>\n                                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>\n                                                </div>\n                                            </group>\n                                        </group>\n                                        <group>\n                                            <field name="company_id" invisible="1"/>    <!-- Need to save value from parented record, cf onchange -->\n                                            <label for="comment"/>\n                                            <field name="comment" options="{'height': 100}" placeholder="Internal notes..." nolabel="1"/>\n                                        </group>\n                                        <field name="lang" invisible="True"/>  <!-- Need to add lang to save default value from parented record -->\n                                    </sheet>\n                                </form>\n                            </field>\n                        </page>\n                        <page name="sales_purchases" string="Sales &amp; Purchase">\n                            <group name="container_row_2">\n                                <group string="Sales" name="sale" priority="1">\n                                    <field name="user_id" widget="many2one_avatar_user" domain="[('share', '=', False)]"/>\n                                </group>\n                                <group string="Purchase" name="purchase" priority="2">\n                                </group>\n                                <group name="misc" string="Misc">\n                                    <field name="company_registry_placeholder" invisible="1"/> <!-- Needed for the placeholder widget -->\n                                    <field name="company_registry" invisible="parent_id or not is_company" options="{'placeholder_field': 'company_registry_placeholder'}"/>\n                                    <field name="ref" string="Reference"/>\n                                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" readonly="parent_id" force_save="1" placeholder="Visible to all"/>\n                                    <field name="company_id" invisible="1"/> <!-- need to be able to compute based on the company even without multi company groups -->\n                                    <field name="industry_id" invisible="not is_company" options="{'no_create': True}"/>\n                                </group>\n                            </group>\n                        </page>\n                        <page name="internal_notes" string="Notes">\n                            <field name="comment" placeholder="Internal notes..."/>\n                            <group name="warnings"/>\n                        </page>\n                    </notebook>\n                </sheet>\n                </form>\n            	f	t	2026-09-09 14:26:16.143585	2026-09-09 14:26:16.143585
