229	16	\N	1	1	Two-Factor Authentication	\N	auth_totp.auth_totp_form	qweb	auth_totp/views/templates.xml	primary	{"en_US": "<t name=\\"Two-Factor Authentication\\" t-name=\\"auth_totp.auth_totp_form\\">\\n        <t t-call=\\"web.login_layout\\">\\n            <t t-set=\\"disable_footer\\">1</t>\\n            <div class=\\"oe_login_form\\">\\n                <h5 class=\\"card-title\\">Two-factor Authentication</h5>\\n                <form method=\\"POST\\" action=\\"\\" class=\\"\\">\\n                    <div class=\\"mb-2 mt-2 text-muted\\">\\n                        To login, enter below the six-digit authentication code provided by your Authenticator app.\\n                        <br/>\\n                        <a href=\\"https://www.odoo.com/documentation/latest/applications/general/auth/2fa.html\\" title=\\"Learn More\\" target=\\"_blank\\">Learn More</a>\\n                    </div>\\n                    <input type=\\"hidden\\" name=\\"csrf_token\\" t-att-value=\\"request.csrf_token()\\"/>\\n                    <input type=\\"hidden\\" name=\\"redirect\\" t-att-value=\\"redirect\\"/>\\n                    <div class=\\"mb-3\\">\\n                        <label class=\\"fw-bold\\" for=\\"totp_token\\">Authentication Code</label>\\n                        <input id=\\"totp_token\\" name=\\"totp_token\\" class=\\"form-control mb-2\\" autocomplete=\\"off\\" inputmode=\\"numeric\\" autofocus=\\"autofocus\\" required=\\"required\\" placeholder=\\"e.g. 123456\\"/>\\n                    </div>\\n                    <div class=\\"text-center py-2 border-top\\">\\n                        <p class=\\"alert alert-danger\\" t-if=\\"error\\" role=\\"alert\\">\\n                            <t t-esc=\\"error\\"/>\\n                        </p>\\n                    <div class=\\"mb-2 mt-2 text-muted\\">\\n                        <input type=\\"checkbox\\" name=\\"remember\\" id=\\"switch-remember\\" value=\\"1\\"/>\\n                        <label for=\\"switch-remember\\">Don't ask again on this device</label>\\n                    </div>\\n                        <div t-attf-class=\\"clearfix oe_login_buttons text-center d-grid mb-1\\">\\n                            <button type=\\"submit\\" class=\\"btn btn-primary\\">\\n                                Log in\\n                            </button>\\n                        </div>\\n\\n                    </div>\\n                </form>\\n\\n                <form method=\\"POST\\" action=\\"/web/session/logout\\">\\n                    <input type=\\"hidden\\" name=\\"csrf_token\\" t-att-value=\\"request.csrf_token()\\"/>\\n                    <div class=\\"w-100 text-center\\">\\n                        <button type=\\"submit\\" class=\\"btn btn-link btn-sm mb-2\\">\\n                            Cancel\\n                        </button>\\n                    </div>\\n                </form>\\n            </div>\\n        </t>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Two-Factor Authentication" t-name="auth_totp.auth_totp_form">\n        <t t-call="web.login_layout">\n            <t t-set="disable_footer">1</t>\n            <div class="oe_login_form">\n                <h5 class="card-title">Two-factor Authentication</h5>\n                <form method="POST" action="" class="">\n                    <div class="mb-2 mt-2 text-muted">\n                        To login, enter below the six-digit authentication code provided by your Authenticator app.\n                        <br/>\n                        <a href="https://www.odoo.com/documentation/latest/applications/general/auth/2fa.html" title="Learn More" target="_blank">Learn More</a>\n                    </div>\n                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n                    <input type="hidden" name="redirect" t-att-value="redirect"/>\n                    <div class="mb-3">\n                        <label class="fw-bold" for="totp_token">Authentication Code</label>\n                        <input id="totp_token" name="totp_token" class="form-control mb-2" autocomplete="off" inputmode="numeric" autofocus="autofocus" required="required" placeholder="e.g. 123456"/>\n                    </div>\n                    <div class="text-center py-2 border-top">\n                        <p class="alert alert-danger" t-if="error" role="alert">\n                            <t t-esc="error"/>\n                        </p>\n                    <div class="mb-2 mt-2 text-muted">\n                        <input type="checkbox" name="remember" id="switch-remember" value="1"/>\n                        <label for="switch-remember">Don't ask again on this device</label>\n                    </div>\n                        <div t-attf-class="clearfix oe_login_buttons text-center d-grid mb-1">\n                            <button type="submit" class="btn btn-primary">\n                                Log in\n                            </button>\n                        </div>\n\n                    </div>\n                </form>\n\n                <form method="POST" action="/web/session/logout">\n                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n                    <div class="w-100 text-center">\n                        <button type="submit" class="btn btn-link btn-sm mb-2">\n                            Cancel\n                        </button>\n                    </div>\n                </form>\n            </div>\n        </t>\n    </t>\n	f	t	2026-09-09 14:26:23.738593	2026-09-09 14:26:23.738593
230	16	\N	1	1	auth_totp wizard	auth_totp.wizard	\N	form	auth_totp/wizard/auth_totp_wizard_views.xml	primary	{"en_US": "<form>\\n                <sheet>\\n                    <div class=\\"o_auth_totp_enable_2FA text-center ps-0\\">\\n                        <div class=\\"mb-3 w-100\\">\\n\\n                            <!-- Desktop version -->\\n                            <h3 class=\\"fw-bold d-none d-md-block\\">Scan this barcode in your Authenticator app</h3>\\n                            <div class=\\"d-none d-md-block\\">\\n                                <field name=\\"qrcode\\" readonly=\\"True\\" widget=\\"image\\" options=\\"{'reload': false }\\"/>\\n\\n                                <h3 class=\\"fw-bold\\"><a data-bs-toggle=\\"collapse\\" href=\\"#collapseTotpSecret\\" role=\\"button\\" aria-expanded=\\"false\\" aria-controls=\\"collapseTotpSecret\\">Cannot scan it?</a></h3>\\n                                <div class=\\"collapse\\" id=\\"collapseTotpSecret\\">\\n                                  <field name=\\"secret\\" widget=\\"CopyClipboardChar\\" readonly=\\"1\\" class=\\"mb-3 ps-3\\"/>\\n                                </div>\\n                            </div>\\n\\n                            <!-- Mobile Version -->\\n                            <h3 class=\\"fw-bold d-block d-md-none\\">Add this key in your Authenticator app</h3>\\n                            <div class=\\"d-block d-md-none\\">\\n                                <field name=\\"secret\\" widget=\\"CopyClipboardChar\\" readonly=\\"1\\" class=\\"mb-3 ps-3\\"/>\\n                            </div>\\n\\n                            <h3 class=\\"fw-bold\\">Write the code given by your app</h3>\\n                            <field required=\\"True\\" name=\\"code\\" autocomplete=\\"off\\" class=\\"o_field_highlight w-50 w-sm-25\\" placeholder=\\"Verification code\\"/>\\n                        </div>\\n                    </div>\\n                </sheet>\\n                <footer>\\n                    <button type=\\"object\\" name=\\"enable\\" class=\\"btn btn-primary\\" context=\\"{'code': code}\\" string=\\"Enable Two-Factor Authentication\\" data-hotkey=\\"q\\"/>\\n                    <button string=\\"Discard\\" special=\\"cancel\\" data-hotkey=\\"x\\"/>\\n                </footer>\\n            </form>"}	<?xml version="1.0"?>\n<form>\n                <sheet>\n                    <div class="o_auth_totp_enable_2FA text-center ps-0">\n                        <div class="mb-3 w-100">\n\n                            <!-- Desktop version -->\n                            <h3 class="fw-bold d-none d-md-block">Scan this barcode in your Authenticator app</h3>\n                            <div class="d-none d-md-block">\n                                <field name="qrcode" readonly="True" widget="image" options="{'reload': false }"/>\n\n                                <h3 class="fw-bold"><a data-bs-toggle="collapse" href="#collapseTotpSecret" role="button" aria-expanded="false" aria-controls="collapseTotpSecret">Cannot scan it?</a></h3>\n                                <div class="collapse" id="collapseTotpSecret">\n                                  <field name="secret" widget="CopyClipboardChar" readonly="1" class="mb-3 ps-3"/>\n                                </div>\n                            </div>\n\n                            <!-- Mobile Version -->\n                            <h3 class="fw-bold d-block d-md-none">Add this key in your Authenticator app</h3>\n                            <div class="d-block d-md-none">\n                                <field name="secret" widget="CopyClipboardChar" readonly="1" class="mb-3 ps-3"/>\n                            </div>\n\n                            <h3 class="fw-bold">Write the code given by your app</h3>\n                            <field required="True" name="code" autocomplete="off" class="o_field_highlight w-50 w-sm-25" placeholder="Verification code"/>\n                        </div>\n                    </div>\n                </sheet>\n                <footer>\n                    <button type="object" name="enable" class="btn btn-primary" context="{'code': code}" string="Enable Two-Factor Authentication" data-hotkey="q"/>\n                    <button string="Discard" special="cancel" data-hotkey="x"/>\n                </footer>\n            </form>\n        	f	t	2026-09-09 14:26:23.738593	2026-09-09 14:26:23.738593
