string=\\"Help\\">\\n                                <field colspan=\\"2\\" name=\\"help\\" options=\\"{'codeview': true}\\" nolabel=\\"1\\" class=\\"oe-bordered-editor\\"/>\\n                            </group>\\n                            <group name=\\"views_tree\\" string=\\"Views\\">\\n                                <field colspan=\\"2\\" name=\\"view_ids\\" nolabel=\\"1\\">\\n                                    <form string=\\"Views\\">\\n                                        <group>\\n                                            <field name=\\"sequence\\"/>\\n                                            <field name=\\"view_mode\\"/>\\n                                            <field domain=\\"[('type', '=', view_mode)]\\" name=\\"view_id\\"/>\\n                                        </group>\\n                                    </form>\\n                                    <list string=\\"Views\\">\\n                                        <field name=\\"sequence\\" widget=\\"handle\\"/>\\n                                        <field name=\\"view_mode\\"/>\\n                                        <field name=\\"view_id\\"/>\\n                                    </list>\\n                                </field>\\n                            </group>\\n                        </page>\\n                        <page string=\\"Visibility\\" name=\\"security\\">\\n                            <field name=\\"group_ids\\"/>\\n                        </page>\\n                    </notebook>\\n                </sheet>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Open a Window">\n                <sheet>\n                    <group>\n                        <group name="main_details">\n                            <field name="name"/>\n                            <field name="xml_id" string="External ID"/>\n                            <field name="path" string="Path"/>\n                            <field name="res_model" string="Object"/>\n                        </group>\n                        <group name="action_details">\n                            <field name="usage"/>\n                            <field name="type" readonly="1"/>\n                            <field name="target"/>\n                            <field name="cache"/>\n                        </group>\n                    </group>\n                    <notebook>\n                        <page name="general_settings" string="General Settings">\n                            <group>\n                                <group name="views" string="Views">\n                                    <field name="view_mode"/>\n                                    <field name="mobile_view_mode"/>\n                                    <field name="view_id"/>\n                                    <field name="search_view_id"/>\n                                </group>\n                                <group name="filters" string="Filters">\n                                    <field name="domain"/>\n                                    <field name="context"/>\n                                    <field name="limit"/>\n                                    <field name="filter"/>\n                                </group>\n                            </group>\n                            <group name="help" string="Help">\n                                <field colspan="2" name="help" options="{'codeview': true}" nolabel="1" class="oe-bordered-editor"/>\n                            </group>\n                            <group name="views_tree" string="Views">\n                                <field colspan="2" name="view_ids" nolabel="1">\n                                    <form string="Views">\n                                        <group>\n                                            <field name="sequence"/>\n                                            <field name="view_mode"/>\n                                            <field domain="[('type', '=', view_mode)]" name="view_id"/>\n                                        </group>\n                                    </form>\n                                    <list string="Views">\n                                        <field name="sequence" widget="handle"/>\n                                        <field name="view_mode"/>\n                                        <field name="view_id"/>\n                                    </list>\n                                </field>\n                            </group>\n                        </page>\n                        <page string="Visibility" name="security">\n                            <field name="group_ids"/>\n                        </page>\n                    </notebook>\n                </sheet>\n                </form>\n            	f	t	2026-09-09 14:26:16.143585	2026-09-09 14:26:16.143585
