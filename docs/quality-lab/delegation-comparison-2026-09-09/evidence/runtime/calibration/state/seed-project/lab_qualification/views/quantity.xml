<odoo>
    <record id="quantity_form" model="ir.ui.view">
        <field name="name">lab.qualification.form</field>
        <field name="model">lab.qualification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet><group>
                    <field name="name"/>
                    <field name="quantity"/>
                    <field name="unit_price"/>
                    <field name="amount"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="quantity_action" model="ir.actions.act_window">
        <field name="name">Synthetic quantities</field>
        <field name="res_model">lab.qualification</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
